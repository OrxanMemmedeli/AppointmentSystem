@model ParentLoginViewModel

@{
    ViewData["Title"] = "Valideyn Girişi";
    var company = ViewData["Company"] as Company;
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <!-- Company Info -->
            @if (company != null)
            {
                <div class="text-center mb-4">
                    @if (!string.IsNullOrEmpty(company.LogoPath))
                    {
                        <img src="@company.LogoPath" alt="@company.Name"
                             style="max-width: 100px; height: 100px; object-fit: contain;" class="mb-3" />
                    }
                    <h4>@company.Name</h4>
                    <p class="text-muted">Valideyn Girişi</p>
                </div>
            }

            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">
                        <i class="bi bi-people text-primary"></i> Valideyn Girişi
                    </h3>

                    <form asp-action="ParentLogin" method="post" id="parentLoginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- FIN Kod -->
                        <div class="mb-3">
                            <label asp-for="FinCode" class="form-label">
                                <i class="bi bi-credit-card"></i> FIN Kod
                            </label>
                            <input asp-for="FinCode"
                                   class="form-control form-control-lg text-uppercase"
                                   placeholder="FIN kod"
                                   maxlength="7"
                                   required
                                   style="text-transform: uppercase;" />
                            <span asp-validation-for="FinCode" class="text-danger"></span>
                        </div>

                        <!-- Baş Hərflər (Initials) -->
                        <div class="mb-4">
                            <label asp-for="Initials" class="form-label">
                                <i class="bi bi-person-badge"></i> Ad və Soyad Baş Hərfləri
                            </label>
                            <input asp-for="Initials"
                                   class="form-control form-control-lg text-uppercase"
                                   placeholder="Məs: OM"
                                   maxlength="10"
                                   required
                                   style="text-transform: uppercase;" />
                            <small class="form-text text-muted">
                                Adınızın və soyadınızın baş hərflərini daxil edin (məs: Orxan Məmmədov → OM)
                            </small>
                            <span asp-validation-for="Initials" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Daxil ol
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-action="SelectCompany" class="text-muted">
                                <i class="bi bi-arrow-left"></i> Geri qayıt
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info Card -->
            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info">
                        <i class="bi bi-info-circle"></i> Məlumat
                    </h6>
                    <ul class="small mb-0 ps-3">
                        <li>FIN kodunuzu şəxsiyyət vəsiqənizdən götürün</li>
                        <li>Ad və soyadınızın baş hərflərini böyük hərflərlə yazın</li>
                        <li>Məsələn: <strong>Orxan Məmmədəli</strong> → <strong>OM</strong></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // FIN və Initials inputlarını avtomatik uppercase et
        document.addEventListener('DOMContentLoaded', function() {
            const finInput = document.getElementById('@Html.IdFor(m => m.FinCode)');
            const initialsInput = document.getElementById('@Html.IdFor(m => m.Initials)');

            // FIN kod üçün uppercase
            if (finInput) {
                finInput.addEventListener('input', function(e) {
                    this.value = this.value.toUpperCase();
                });
            }

            // Initials üçün uppercase
            if (initialsInput) {
                initialsInput.addEventListener('input', function(e) {
                    this.value = this.value.toUpperCase();
                });
            }
        });
    </script>
}