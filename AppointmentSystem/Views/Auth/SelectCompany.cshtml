@model List<CompanyCardViewModel>

@{
    ViewData["Title"] = "Şirkət Seçimi";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3">
            <i class="bi bi-building"></i> Təhsil Müəssisəsini Seçin
        </h1>
        <p class="lead text-muted">Davam etmək üçün təhsil müəssisənizi seçin</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i> Hal-hazırda heç bir müəssisə qeydiyyatdan keçməyib.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var company in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm company-card">
                        <div class="position-relative company-header">
                            <img src="@(company.BackgroundImagePath ?? "/images/default-bg.jpg")"
                                 class="card-img-top"
                                 style="height: 200px; object-fit: cover;"
                                 alt="@company.Name" />
                            <img src="@(company.LogoPath ?? "/images/default-logo.png")"
                                 class="company-logo"
                                 alt="@company.Name Logo" />
                        </div>
                        <div class="card-body text-center pt-5">
                            <h5 class="card-title fw-bold">@company.Name</h5>

                            @if (!string.IsNullOrEmpty(company.Description))
                            {
                                <p class="card-text text-muted small">@company.Description</p>
                            }

                            @if (!string.IsNullOrEmpty(company.Address))
                            {
                                <p class="card-text mb-2">
                                    <i class="bi bi-geo-alt text-primary"></i> @company.Address
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(company.PhoneNumber))
                            {
                                <p class="card-text mb-2">
                                    <i class="bi bi-telephone text-primary"></i> @company.PhoneNumber
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(company.Email))
                            {
                                <p class="card-text mb-3">
                                    <i class="bi bi-envelope text-primary"></i> @company.Email
                                </p>
                            }

                            <div class="d-grid gap-2">
                                <div class="btn-group" role="group">
                                    <a asp-action="ParentLogin" asp-route-companyId="@company.Id"
                                       class="btn btn-outline-primary">
                                        <i class="bi bi-people"></i> Valideyn
                                    </a>
                                    <a asp-action="TeacherLogin" asp-route-companyId="@company.Id"
                                       class="btn btn-outline-success">
                                        <i class="bi bi-person-badge"></i> Müəllim
                                    </a>
                                </div>

                                @if (!string.IsNullOrEmpty(company.MapUrl))
                                {
                                    <a href="@company.MapUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-map"></i> Xəritədə gör
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-5">
        <hr class="my-4" />
        <p class="text-muted mb-3">Administrator girişi</p>
        <a asp-action="AdminLogin" class="btn btn-dark btn-lg">
            <i class="bi bi-shield-lock"></i> Admin Panel
        </a>
    </div>
</div>

@section Styles {
    <style>
        .company-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 2px solid transparent;
        }

            .company-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 30px rgba(0,0,0,0.2) !important;
                border-color: #0d6efd;
            }

        .company-header {
            position: relative;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .company-logo {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 6px solid white;
            object-fit: cover;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            background: white;
        }
    </style>
}