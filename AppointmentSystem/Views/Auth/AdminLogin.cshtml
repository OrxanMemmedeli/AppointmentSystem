@model AdminLoginViewModel

@{
    ViewData["Title"] = "Admin Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .admin-login-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 30px 70px rgba(0,0,0,0.5);
            backdrop-filter: blur(10px);
        }

        .admin-header {
            background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);
            color: white;
            padding: 40px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .admin-header::before {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: repeating-linear-gradient( 45deg, transparent, transparent 10px, rgba(255,255,255,0.05) 10px, rgba(255,255,255,0.05) 20px );
                animation: slide 20s linear infinite;
            }
        @@keyframes slide {
            0%

        {
            transform: translate(0, 0);
        }

        100% {
            transform: translate(50px, 50px);
        }

        }

        .shield-icon {
            font-size: 4rem;
            color: #ffd700;
            text-shadow: 0 5px 15px rgba(255, 215, 0, 0.5);
        }

        .form-control {
            height: 55px;
            border-radius: 10px;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #2c3e50;
                box-shadow: 0 0 0 0.2rem rgba(44, 62, 80, 0.25);
            }

        .btn-admin {
            height: 55px;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);
            border: none;
            transition: all 0.3s ease;
        }

            .btn-admin:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 25px rgba(44, 62, 80, 0.4);
            }

        .security-badge {
            display: inline-block;
            padding: 5px 15px;
            background: rgba(255, 215, 0, 0.2);
            border: 2px solid #ffd700;
            border-radius: 20px;
            color: #ffd700;
            font-size: 0.85rem;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="admin-login-card">
                    <!-- Header -->
                    <div class="admin-header">
                        <i class="bi bi-shield-lock shield-icon"></i>
                        <h2 class="mt-3 mb-2 position-relative">Admin Panel</h2>
                        <span class="security-badge">
                            <i class="bi bi-lock-fill"></i> Secure Access
                        </span>
                    </div>

                    <!-- Login Form -->
                    <div class="p-4 p-md-5">
                        <form asp-action="AdminLogin" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <input type="hidden" asp-for="ReturnUrl" />

                            <!-- Username or Email -->
                            <div class="mb-3">
                                <label asp-for="UserNameOrEmail" class="form-label fw-semibold">
                                    <i class="bi bi-person-circle"></i> İstifadəçi adı və ya Email
                                </label>
                                <input asp-for="UserNameOrEmail"
                                       class="form-control"
                                       placeholder="admin"
                                       autocomplete="username" />
                                <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3 position-relative">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="bi bi-key-fill"></i> Şifrə
                                </label>
                                <input asp-for="Password"
                                       type="password"
                                       id="passwordInput"
                                       class="form-control"
                                       placeholder="••••••••"
                                       autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me -->
                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe" />
                                <label asp-for="RememberMe" class="form-check-label" for="rememberMe">
                                    24 saat yadda saxla
                                </label>
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid">
                                <button type="submit" class="btn btn-dark btn-admin">
                                    <i class="bi bi-shield-check"></i> Daxil Ol
                                </button>
                            </div>

                            <!-- Default Credentials -->
                            <div class="alert alert-info mt-4 mb-0 border-0">
                                <small>
                                    <i class="bi bi-info-circle-fill"></i>
                                    <strong>Default:</strong> admin / Admin123!
                                </small>
                            </div>
                        </form>
                    </div>

                    <!-- Footer -->
                    <div class="text-center p-3 bg-dark text-white-50">
                        <small>
                            <i class="bi bi-shield-fill-check"></i> Secure Connection Established
                        </small>
                    </div>
                </div>

                <!-- Back Link -->
                <div class="text-center mt-4">
                    <a asp-action="SelectCompany" class="text-white text-decoration-none">
                        <i class="bi bi-arrow-left-circle"></i> Ana səhifəyə qayıt
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>