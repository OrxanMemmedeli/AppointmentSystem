@{
    ViewData["Title"] = "Giriş Qadağandır";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card text-center shadow-lg border-danger">
                <div class="card-body py-5">
                    <i class="bi bi-shield-x text-danger" style="font-size: 5rem;"></i>
                    <h1 class="mt-4 text-danger">403</h1>
                    <h3>Giriş Qadağandır</h3>
                    <p class="text-muted">Bu səhifəyə daxil olmaq üçün icazəniz yoxdur.</p>
                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary me-2">
                            <i class="bi bi-house"></i> Ana səhifə
                        </a>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="bi bi-box-arrow-right"></i> Çıxış
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>