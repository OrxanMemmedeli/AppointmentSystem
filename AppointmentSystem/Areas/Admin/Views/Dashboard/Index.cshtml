@model AppointmentSystem.Areas.Admin.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Statistika Kartları -->
    <div class="row g-4 mb-4">
        <!-- Şirkətlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Şirkətlər</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.TotalCompanies</h3>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Müəllimlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Müəllimlər</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.TotalTeachers</h3>
                            @if (Model.Statistics.TeachersChangePercent != 0)
                            {
                                <small class="@(Model.Statistics.TeachersChangePercent > 0 ? "text-success" : "text-danger")">
                                    <i class="bi @(Model.Statistics.TeachersChangePercent > 0 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                    @Model.Statistics.TeachersChangePercent%
                                </small>
                            }
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-person-badge text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Şagirdlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Şagirdlər</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.TotalStudents</h3>
                            @if (Model.Statistics.StudentsChangePercent != 0)
                            {
                                <small class="@(Model.Statistics.StudentsChangePercent > 0 ? "text-success" : "text-danger")">
                                    <i class="bi @(Model.Statistics.StudentsChangePercent > 0 ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                    @Model.Statistics.StudentsChangePercent%
                                </small>
                            }
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-mortarboard text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Valideynlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted mb-1 small">Valideynlər</p>
                            <h3 class="mb-0 fw-bold">@Model.Statistics.TotalParents</h3>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                            <i class="bi bi-people text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- İkinci sətir - Görüşlər -->
    <div class="row g-4 mb-4">
        <!-- Bugünkü görüşlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Bugünkü Görüşlər</p>
                            <h3 class="mb-0 fw-bold text-primary">@Model.Statistics.TodayMeetings</h3>
                        </div>
                        <i class="bi bi-calendar-day text-primary fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gözləyən görüşlər -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Gözləyən</p>
                            <h3 class="mb-0 fw-bold text-warning">@Model.Statistics.PendingMeetings</h3>
                        </div>
                        <i class="bi bi-hourglass-split text-warning fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tamamlanmış -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Bu Ay Tamamlanmış</p>
                            <h3 class="mb-0 fw-bold text-success">@Model.Statistics.CompletedMeetingsThisMonth</h3>
                        </div>
                        <i class="bi bi-check-circle text-success fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ləğv edilmiş -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Bu Ay Ləğv Edilmiş</p>
                            <h3 class="mb-0 fw-bold text-danger">@Model.Statistics.CancelledMeetingsThisMonth</h3>
                        </div>
                        <i class="bi bi-x-circle text-danger fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Gələcək Görüşlər -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="bi bi-calendar-event text-primary me-2"></i>
                        Gələcək Görüşlər
                    </h6>
                    <a asp-area="Admin" asp-controller="Meeting" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        Hamısına bax
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.UpcomingMeetings != null && Model.UpcomingMeetings.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tarix</th>
                                        <th>Vaxt</th>
                                        <th>Müəllim</th>
                                        <th>Valideyn</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var meeting in Model.UpcomingMeetings)
                                    {
                                        <tr>
                                            <td>@meeting.MeetingDate.ToString("dd MMM")</td>
                                            <td>@meeting.StartTime.ToString(@"hh\:mm") - @meeting.EndTime.ToString(@"hh\:mm")</td>
                                            <td>@meeting.TeacherName</td>
                                            <td>@meeting.ParentName</td>
                                            <td><span class="badge @meeting.StatusBadgeClass">@meeting.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-4"></i>
                            <p class="mt-3">Gələcək görüş yoxdur</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Son Fəaliyyətlər -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0">
                        <i class="bi bi-activity text-success me-2"></i>
                        Son Fəaliyyətlər
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var activity in Model.RecentActivities.Take(5))
                            {
                                <li class="list-group-item">
                                    <div class="d-flex align-items-start">
                                        <div class="bg-@activity.IconColor bg-opacity-10 rounded p-2 me-3">
                                            <i class="bi @activity.Icon text-@activity.IconColor"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <p class="mb-1 fw-medium">@activity.Title</p>
                                            <small class="text-muted">@activity.Description</small>
                                            <br />
                                            <small class="text-muted">@activity.Timestamp.ToString("dd MMM HH:mm")</small>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4"></i>
                            <p class="mt-3">Fəaliyyət yoxdur</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
