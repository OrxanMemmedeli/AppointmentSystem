@model SubjectViewModel
@{
    ViewData["Title"] = "Yeni Fənn";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-book"></i> Yeni Fənn Yarat</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Əsas Məlumatlar -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-info-circle"></i> Əsas Məlumatlar
                        </h5>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">
                                        Fənn Adı <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control"
                                           placeholder="Məsələn: Riyaziyyat" autofocus />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label">Kod</label>
                                    <input asp-for="Code" class="form-control text-uppercase"
                                           placeholder="MATH" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                    <small class="text-muted">Unikal sistem kodu</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Təsvir</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Fənn haqqında qısa məlumat..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Aktiv
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Məlumat Kartı -->
            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info mb-3">
                        <i class="bi bi-lightbulb"></i> Məlumat
                    </h6>
                    <ul class="small mb-0">
                        <li>Fənn adı <strong>unikal</strong> olmalıdır</li>
                        <li>Kod <strong>istəyə bağlıdır</strong>, amma unikal olmalıdır</li>
                        <li>Kodu böyük hərflərlə daxil edin (məs: MATH, PHYS, CHEM)</li>
                        <li>Fənn yaradıldıqdan sonra şirkətlərə və müəllimlərə təyin edilə bilər</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Kod inputunu uppercase et
            const codeInput = document.getElementById('@Html.IdFor(m => m.Code)');
            if (codeInput) {
                codeInput.addEventListener('input', function() {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9_]/g, '');
                });
            }
        });
    </script>
}