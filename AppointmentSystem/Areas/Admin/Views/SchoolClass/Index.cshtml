@model List<SchoolClassListViewModel>
@{
    ViewData["Title"] = "Sinif İdarəetməsi";
    var filterCompanyId = ViewData["FilterCompanyId"] as Guid?;
    var companies = ViewData["Companies"] as List<SelectListItem>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-grid-3x3"></i> Sinif İdarəetməsi</h2>
        <a asp-action="Create" asp-route-companyId="@filterCompanyId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Sinif
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Sinif</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-grid-3x3 text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(c => c.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Şagird</h6>
                            <h3 class="mb-0">@Model.Sum(c => c.StudentCount)</h3>
                        </div>
                        <i class="bi bi-people text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Müəllim Təyinləri</h6>
                            <h3 class="mb-0">@Model.Sum(c => c.TeacherCount)</h3>
                        </div>
                        <i class="bi bi-person-badge text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="Sinif adı ilə axtar...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterCompany">
                        <option value="">Bütün Şirkətlər</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Value" selected="@(company.Value == filterCompanyId?.ToString())">
                                @company.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="filterLevel">
                        <option value="">Bütün Səviyyələr</option>
                        @for (int i = 1; i <= 11; i++)
                        {
                            <option value="@i">@i-ci sinif</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="filterStatus">
                        <option value="">Bütün Statuslar</option>
                        <option value="active">Aktiv</option>
                        <option value="inactive">Deaktiv</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-outline-secondary w-100" id="clearFilters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="classTable">
                    <thead class="table-light">
                        <tr>
                            <th>Sinif</th>
                            <th>Səviyyə</th>
                            <th>Şöbə</th>
                            <th>Şirkət</th>
                            <th>Şagirdlər</th>
                            <th>Müəllimlər</th>
                            <th>Status</th>
                            <th style="width: 180px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schoolClass in Model)
                        {
                            <tr data-company="@schoolClass.CompanyId"
                                data-level="@schoolClass.Level"
                                data-status="@(schoolClass.IsActive ? "active" : "inactive")">
                                <td>
                                    <strong>@schoolClass.Name</strong>
                                    @if (!string.IsNullOrEmpty(schoolClass.Description))
                                    {
                                        <br />
                                
                                        <small class="text-muted">@schoolClass.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@schoolClass.Level</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(schoolClass.Section))
                                    {
                                        <span class="badge bg-info">@schoolClass.Section</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@schoolClass.CompanyName</small>
                                </td>
                                <td>
                                    <span class="badge bg-info" title="Şagird sayı">
                                        <i class="bi bi-people"></i> @schoolClass.StudentCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success" title="Müəllim sayı">
                                        <i class="bi bi-person-badge"></i> @schoolClass.TeacherCount
                                    </span>
                                </td>
                                <td>
                                    @if (schoolClass.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@schoolClass.Id"
                                           class="btn btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@schoolClass.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@schoolClass.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(schoolClass.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(schoolClass.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@schoolClass.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ sinif yaradılmayıb</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Sinfi Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const filterCompany = document.getElementById('filterCompany');
            const filterLevel = document.getElementById('filterLevel');
            const filterStatus = document.getElementById('filterStatus');
            const clearFilters = document.getElementById('clearFilters');
            const tableRows = document.querySelectorAll('#classTable tbody tr');

            function applyFilters() {
                const searchTerm = searchInput.value.toLowerCase();
                const companyValue = filterCompany.value;
                const levelValue = filterLevel.value;
                const statusValue = filterStatus.value;

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const company = row.dataset.company;
                    const level = row.dataset.level;
                    const status = row.dataset.status;

                    let show = true;

                    if (searchTerm && !text.includes(searchTerm)) show = false;
                    if (companyValue && company !== companyValue) show = false;
                    if (levelValue && level !== levelValue) show = false;
                    if (statusValue && status !== statusValue) show = false;

                    row.style.display = show ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', applyFilters);
            filterCompany.addEventListener('change', function() {
                if (this.value) {
                    window.location.href = '@Url.Action("Index")?companyId=' + this.value;
                } else {
                    window.location.href = '@Url.Action("Index")';
                }
            });
            filterLevel.addEventListener('change', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            clearFilters.addEventListener('click', function() {
                searchInput.value = '';
                filterLevel.value = '';
                filterStatus.value = '';
                applyFilters();
            });
        });
    </script>
}