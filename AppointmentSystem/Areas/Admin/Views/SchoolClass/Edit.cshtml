@model SchoolClassViewModel
@{
    ViewData["Title"] = "Sinif Redaktəsi";
    var companies = ViewData["Companies"] as List<SelectListItem>;
    var levels = ViewData["Levels"] as List<SelectListItem>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Sinif Redaktə Et</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="CompanyId" class="form-label">
                                Şirkət/Məktəb <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CompanyId" asp-items="companies" class="form-select">
                                <option value="">Şirkət seçin</option>
                            </select>
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Level" class="form-label">
                                        Səviyyə <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="Level" asp-items="levels" class="form-select">
                                        <option value="">Səviyyə seçin</option>
                                    </select>
                                    <span asp-validation-for="Level" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Section" class="form-label">Şöbə</label>
                                    <input asp-for="Section" class="form-control text-uppercase"
                                           placeholder="A, B, C" maxlength="10" />
                                    <span asp-validation-for="Section" class="text-danger"></span>
                                    <small class="text-muted">Böyük hərflər</small>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">
                                        Sinif Adı <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control"
                                           placeholder="10-A" readonly id="className" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                    <small class="text-muted">Avtomatik yaranır</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Açıqlama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Sinif haqqında əlavə məlumat..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input"
                                   type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Aktiv
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" asp-route-companyId="@Model.CompanyId" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-save"></i> Dəyişiklikləri Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Xəbərdarlıq -->
            <div class="alert alert-warning mt-3">
                <h6 class="alert-heading">
                    <i class="bi bi-exclamation-triangle"></i> Xəbərdarlıq
                </h6>
                <small class="mb-0">
                    Sinfin şirkətini dəyişdirmək bu sinfə aid bütün şagird və müəllim təyinlərini
                    təsir edə bilər. Ehtiyatlı olun.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const levelSelect = document.getElementById('@Html.IdFor(m => m.Level)');
            const sectionInput = document.getElementById('@Html.IdFor(m => m.Section)');
            const nameInput = document.getElementById('className');

            // Section inputunu uppercase et
            sectionInput.addEventListener('input', function() {
                this.value = this.value.toUpperCase().replace(/[^A-ZƏÜÖĞÇŞİ]/g, '');
                updateClassName();
            });

            // Level dəyişəndə
            levelSelect.addEventListener('change', updateClassName);

            function updateClassName() {
                const level = levelSelect.value;
                const section = sectionInput.value.trim();

                if (level) {
                    if (section) {
                        nameInput.value = level + '-' + section;
                    } else {
                        nameInput.value = level;
                    }
                } else {
                    nameInput.value = '';
                }
            }

            // Səhifə yüklənəndə sinif adını set et
            updateClassName();
        });
    </script>
}