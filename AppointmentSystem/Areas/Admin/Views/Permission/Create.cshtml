@model PermissionViewModel
@{
    ViewData["Title"] = "Yeni İcazə";
    var httpMethods = ViewData["HttpMethods"] as List<string>;
    var permissionTypes = ViewData["PermissionTypes"] as List<SelectListItem>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-key"></i> Yeni İcazə Yarat</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <!-- Sol sütun -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">İcazə Adı *</label>
                                    <input asp-for="Name" class="form-control" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label">Kod</label>
                                    <input asp-for="Code" class="form-control text-uppercase"
                                           placeholder="USER_CREATE" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                    <small class="text-muted">Böyük hərflər və alt xətt</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Type" class="form-label">İcazə Tipi *</label>
                                    <select asp-for="Type" asp-items="permissionTypes" class="form-select">
                                    </select>
                                    <span asp-validation-for="Type" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="HttpMethod" class="form-label">HTTP Metodu *</label>
                                    <select asp-for="HttpMethod" class="form-select">
                                        @foreach (var method in httpMethods)
                                        {
                                            <option value="@method">@method</option>
                                        }
                                    </select>
                                    <span asp-validation-for="HttpMethod" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Sağ sütun -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ResourcePath" class="form-label">Resource Path</label>
                                    <input asp-for="ResourcePath" class="form-control"
                                           placeholder="/admin/users/create" />
                                    <span asp-validation-for="ResourcePath" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="AreaName" class="form-label">Area</label>
                                    <input asp-for="AreaName" class="form-control" placeholder="Admin" />
                                    <span asp-validation-for="AreaName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ControllerName" class="form-label">Controller</label>
                                    <input asp-for="ControllerName" class="form-control" placeholder="Users" />
                                    <span asp-validation-for="ControllerName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ActionName" class="form-label">Action</label>
                                    <input asp-for="ActionName" class="form-control" placeholder="Create" />
                                    <span asp-validation-for="ActionName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Təsvir</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input asp-for="RequiresAuthentication" class="form-check-input" type="checkbox" />
                                    <label asp-for="RequiresAuthentication" class="form-check-label">
                                        Autentifikasiya tələb olunur
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-3">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Aktiv
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Yadda saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}