@model List<PermissionListViewModel>
@{
    ViewData["Title"] = "İcazə İdarəetməsi";
    var filterType = ViewData["FilterType"] as PermissionType?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-key"></i> İcazə İdarəetməsi</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni İcazə
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <strong>Tip üzrə filter:</strong>
                </div>
                <div class="col-auto">
                    <div class="btn-group">
                        <a asp-action="Index" class="btn btn-sm @(filterType == null ? "btn-primary" : "btn-outline-primary")">
                            Hamısı
                        </a>
                        @foreach (PermissionType type in Enum.GetValues<PermissionType>())
                        {
                            <a asp-action="Index" asp-route-type="@type"
                               class="btn btn-sm @(filterType == type ? "btn-primary" : "btn-outline-primary")">
                                @type
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>İcazə Adı</th>
                            <th>Kod</th>
                            <th>Tip</th>
                            <th>HTTP</th>
                            <th>Resource Path</th>
                            <th>Rol</th>
                            <th>User</th>
                            <th>Status</th>
                            <th>Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permission in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@permission.Name</strong>
                                    @if (permission.RequiresAuthentication)
                                    {
                                        <i class="bi bi-lock-fill text-warning" title="Auth tələb olunur"></i>
                                    }
                                </td>
                                <td><code>@permission.Code</code></td>
                                <td>
                                    <span class="badge bg-@(permission.Type switch
                                          {
                                              PermissionType.Action => "primary",
                                              PermissionType.Menu => "info",
                                              PermissionType.Feature => "success",
                                              _ => "secondary"
                                          })">
                                        @permission.Type
                                    </span>
                                </td>
                                <td><span class="badge bg-secondary">@permission.HttpMethod</span></td>
                                <td><small class="text-muted">@(permission.ResourcePath ?? "-")</small></td>
                                <td>@permission.RoleCount</td>
                                <td>@permission.UserCount</td>
                                <td>
                                    @if (permission.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@permission.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@permission.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(permission.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(permission.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@permission.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">İcazə tapılmadı</p>
                </div>
            }
        </div>
    </div>
</div>