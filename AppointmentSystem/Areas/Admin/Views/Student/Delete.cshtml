@model StudentViewModel
@{
    ViewData["Title"] = "Şagird Silinməsi";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Şagird Silinməsi Təsdiqi
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <h5 class="alert-heading">
                            <i class="bi bi-shield-exclamation"></i> Xəbərdarlıq!
                        </h5>
                        <p class="mb-0">
                            Bu şagirdi silmək istədiyinizdən əminsiniz? Bu əməliyyat geri qaytarıla bilməz
                            və şagirdə aid bütün məlumatlar (valideyn əlaqələri, qiymətlər, davamiyyət) əlçatan olmayacaq.
                        </p>
                    </div>

                    <!-- Şagird Məlumatları -->
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <div class="row">
                                @if (!string.IsNullOrEmpty(Model.ImagePath))
                                {
                                    <div class="col-md-3 text-center">
                                        <img src="@Model.ImagePath" alt="@Model.FullName"
                                             class="img-fluid rounded-circle" style="max-width: 150px;" />
                                    </div>
                                    <div class="col-md-9">
                                        <h5 class="card-title mb-3">
                                            <strong>@Model.FullName</strong>
                                        </h5>
                                        @Html.Raw(RenderStudentDetails())
                                    </div>
                                }
                                else
                                {
                                    <div class="col-12">
                                        <h5 class="card-title mb-3">
                                            <i class="bi bi-person text-primary"></i>
                                            <strong>@Model.FullName</strong>
                                        </h5>
                                        @Html.Raw(RenderStudentDetails())
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Təsir Zonası -->
                    <div class="alert alert-warning">
                        <h6><i class="bi bi-info-circle"></i> Bu əməliyyatın nəticələri:</h6>
                        <ul class="mb-0 small">
                            <li>Şagird sistemdən silinəcək (soft delete)</li>
                            <li>Şagirdə aid olan <strong>bütün valideyn əlaqələri</strong> silinəcək</li>
                            <li>Şagirdin <strong>bütün qiymətləri və davamiyyəti</strong> silinəcək</li>
                            <li>Şagirdə aid olan <strong>bütün görüşlər</strong> silinəcək</li>
                            <li>Bu əməliyyat yalnız admin müdaxiləsi ilə geri qaytarıla bilər</li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between gap-2">
                            <a asp-action="Details" asp-route-id="@Model.Id"
                               class="btn btn-secondary btn-lg flex-fill">
                                <i class="bi bi-x-circle"></i> Ləğv Et
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg flex-fill">
                                <i class="bi bi-trash"></i> Bəli, Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Alternativ Əməliyyatlar -->
            <div class="card mt-3 border-primary">
                <div class="card-body">
                    <h6 class="text-primary mb-3">
                        <i class="bi bi-lightbulb"></i> Alternativ Həllər
                    </h6>
                    <div class="d-grid gap-2">
                        <form asp-action="ToggleStatus" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-warning w-100">
                                <i class="bi bi-@(Model.IsActive ? "pause" : "play")-circle"></i>
                                Silmək əvəzinə @(Model.IsActive ? "Deaktiv" : "Aktiv") Et
                            </button>
                        </form>

                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">
                            <i class="bi bi-pencil"></i> Şagirdi Redaktə Et
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string RenderStudentDetails()
    {
        var details = new System.Text.StringBuilder();

        details.Append("<div class='row mb-2'>");
        details.Append("<div class='col-4 text-muted'>FIN Kod:</div>");
        details.Append($"<div class='col-8'><code>{Model.FinCode}</code></div>");
        details.Append("</div>");

        details.Append("<div class='row mb-2'>");
        details.Append("<div class='col-4 text-muted'>Doğum Tarixi:</div>");
        details.Append($"<div class='col-8'>{Model.DateOfBirth:dd.MM.yyyy}</div>");
        details.Append("</div>");

        details.Append("<div class='row mb-2'>");
        details.Append("<div class='col-4 text-muted'>Yaş:</div>");
        details.Append($"<div class='col-8'><span class='badge bg-info'>{Model.Age} yaş</span></div>");
        details.Append("</div>");

        if (!string.IsNullOrEmpty(Model.Notes))
        {
            details.Append("<div class='row mb-2'>");
            details.Append("<div class='col-4 text-muted'>Qeydlər:</div>");
            details.Append($"<div class='col-8'><small>{Model.Notes}</small></div>");
            details.Append("</div>");
        }

        details.Append("<div class='row'>");
        details.Append("<div class='col-4 text-muted'>Status:</div>");
        details.Append($"<div class='col-8'><span class='badge bg-{(Model.IsActive ? "success" : "danger")}'>{(Model.IsActive ? "Aktiv" : "Deaktiv")}</span></div>");
        details.Append("</div>");

        return details.ToString();
    }
}