@model List<StudentListViewModel>
@{
    ViewData["Title"] = "Şagirdlər";
    var companies = ViewData["Companies"] as List<SelectListItem>;
    var classes = ViewData["Classes"] as List<SelectListItem>;
    var filterCompanyId = ViewData["FilterCompanyId"] as Guid?;
    var filterClassId = ViewData["FilterClassId"] as Guid?;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Şagirdlər</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Şagird
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Şagird</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-people text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(s => s.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Valideyni Olan</h6>
                            <h3 class="mb-0">@Model.Count(s => s.ParentCount > 0)</h3>
                        </div>
                        <i class="bi bi-person-hearts text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Orta Yaş</h6>
                            <h3 class="mb-0">@(Model.Any() ? Model.Average(s => s.Age).ToString("F1") : "0")</h3>
                        </div>
                        <i class="bi bi-calendar text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" class="form-control" id="searchInput"
                               placeholder="Ad, soyad və ya FIN kod ilə axtar...">
                    </div>
                    <div class="col-md-3">
                        <select name="companyId" class="form-select" id="companyFilter">
                            <option value="">Bütün Şirkətlər</option>
                            @foreach (var company in companies ?? new List<SelectListItem>())
                            {
                                <option value="@company.Value"
                                        selected="@(company.Value == filterCompanyId?.ToString())">
                                    @company.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="classId" class="form-select" id="classFilter">
                            <option value="">Bütün Siniflər</option>
                            @foreach (var cls in classes ?? new List<SelectListItem>())
                            {
                                <option value="@cls.Value"
                                        selected="@(cls.Value == filterClassId?.ToString())">
                                    @cls.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="btn-group w-100">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-filter"></i> Filter
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="studentTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Ad Soyad</th>
                            <th>FIN</th>
                            <th>Sinif</th>
                            <th>Şirkət</th>
                            <th>Yaş</th>
                            <th>Valideyn</th>
                            <th>Status</th>
                            <th style="width: 150px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(student.ImagePath))
                                    {
                                        <img src="@student.ImagePath" alt="@student.FullName"
                                             class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 40px; height: 40px; font-size: 0.9rem;">
                                            @student.FirstName.Substring(0, 1)@student.LastName.Substring(0, 1)
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@student.FullName</strong>
                                    <br />
                                    <small class="text-muted">@student.DateOfBirth.ToString("dd.MM.yyyy")</small>
                                </td>
                                <td><code>@student.FinCode</code></td>
                                <td>
                                    <span class="badge bg-primary">@student.ClassName</span>
                                </td>
                                <td>
                                    <small class="text-muted">@student.CompanyName</small>
                                </td>
                                <td>
                                    <span class="badge bg-info">@student.Age yaş</span>
                                </td>
                                <td>
                                    @if (student.ParentCount > 0)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-person-check"></i> @student.ParentCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-triangle"></i> Yoxdur
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@student.Id"
                                           class="btn btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@student.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@student.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ şagird qeydiyyatdan keçməyib</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Şagirdi Qeyd Et
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const tableRows = document.querySelectorAll('#studentTable tbody tr');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(searchTerm) ? '' : 'none';
                });
            });

            // Şirkət filter dəyişəndə sinif dropdown-u yenilə
            const companyFilter = document.getElementById('companyFilter');
            if (companyFilter) {
                companyFilter.addEventListener('change', function() {
                    // Form submit et ki, siniflər filterlənsin
                    this.form.submit();
                });
            }
        });
    </script>
}