@model List<TeacherListViewModel>
@{
    ViewData["Title"] = "Müəllim İdarəetməsi";
    var filteredCompanyId = ViewBag.FilteredCompanyId as Guid?;
    var companies = ViewBag.Companies as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-badge"></i> Müəllim İdarəetməsi</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Müəllim
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Müəllim</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-person-badge text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(t => t.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Fənn</h6>
                            <h3 class="mb-0">@Model.Sum(t => t.SubjectCount)</h3>
                        </div>
                        <i class="bi bi-book text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Sinif</h6>
                            <h3 class="mb-0">@Model.Sum(t => t.ClassCount)</h3>
                        </div>
                        <i class="bi bi-grid-3x3 text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="Ad, soyad və ya email ilə axtar...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterCompany" onchange="filterByCompany(this.value)">
                        <option value="">Bütün Şirkətlər</option>
                        @foreach (var company in companies)
                        {
                            @if (filteredCompanyId.HasValue && filteredCompanyId.Value.ToString() == company.Value)
                            {
                                <option value="@company.Value" selected>@company.Text</option>
                            }else
                            {
                                <option value="@company.Value">@company.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterStatus">
                        <option value="">Bütün Statuslar</option>
                        <option value="active">Aktiv</option>
                        <option value="inactive">Deaktiv</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-secondary w-100" id="clearFilters">
                        <i class="bi bi-x-circle"></i> Təmizlə
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="teacherTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Müəllim</th>
                            <th>Şirkət</th>
                            <th>Əlaqə</th>
                            <th>İxtisaslaşma</th>
                            <th>Fənlər</th>
                            <th>Siniflər</th>
                            <th>Status</th>
                            <th style="width: 180px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var teacher in Model)
                        {
                            <tr data-status="@(teacher.IsActive ? "active" : "inactive")"
                                data-company="@teacher.CompanyId">
                                <td>
                                    @if (!string.IsNullOrEmpty(teacher.ImagePath))
                                    {
                                        <img src="@teacher.ImagePath" alt="@teacher.FullName"
                                             class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 50px; height: 50px; font-size: 1.2rem;">
                                            @teacher.FirstName.Substring(0, 1)@teacher.LastName.Substring(0, 1)
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@teacher.FullName</strong>
                                </td>
                                <td>
                                    <small class="text-muted">@teacher.CompanyName</small>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(teacher.Email))
                                        {
                                            <i class="bi bi-envelope"></i> @teacher.Email
                                            <br />
                                        }
                                        @if (!string.IsNullOrEmpty(teacher.PhoneNumber))
                                        {
                                            <i class="bi bi-telephone"></i> @teacher.PhoneNumber
                                        }
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(teacher.Specialization ?? "-")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-info" title="Fənn sayı">
                                        <i class="bi bi-book"></i> @teacher.SubjectCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark" title="Sinif sayı">
                                        <i class="bi bi-grid-3x3"></i> @teacher.ClassCount
                                    </span>
                                </td>
                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@teacher.Id"
                                           class="btn btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@teacher.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@teacher.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(teacher.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(teacher.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@teacher.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ müəllim əlavə edilməyib</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Müəllimi Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const clearFilters = document.getElementById('clearFilters');
            const tableRows = document.querySelectorAll('#teacherTable tbody tr');

            function applyFilters() {
                const searchTerm = searchInput.value.toLowerCase();
                const statusValue = filterStatus.value;

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const status = row.dataset.status;

                    let show = true;

                    if (searchTerm && !text.includes(searchTerm)) show = false;
                    if (statusValue && status !== statusValue) show = false;

                    row.style.display = show ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            clearFilters.addEventListener('click', function() {
                searchInput.value = '';
                filterStatus.value = '';
                document.getElementById('filterCompany').value = '';
                window.location.href = '@Url.Action("Index")';
            });
        });

        function filterByCompany(companyId) {
            if (companyId) {
                window.location.href = '@Url.Action("Index")?companyId=' + companyId;
            } else {
                window.location.href = '@Url.Action("Index")';
            }
        }
    </script>
}