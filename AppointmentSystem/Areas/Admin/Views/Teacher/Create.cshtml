@model TeacherViewModel
@{
    ViewData["Title"] = "Yeni Müəllim";
    var users = ViewBag.Users as List<SelectListItem> ?? new List<SelectListItem>();
    var companies = ViewBag.Companies as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-badge"></i> Yeni Müəllim Yarat</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Əsas Məlumatlar -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-info-circle"></i> Əsas Məlumatlar
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="form-label">
                                        Ad <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FirstName" class="form-control"
                                           placeholder="Məsələn: Əli" autofocus />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LastName" class="form-label">
                                        Soyad <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="LastName" class="form-control"
                                           placeholder="Məsələn: Məmmədov" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">
                                        Email <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control"
                                           placeholder="ali.mammadov@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">Telefon</label>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control"
                                           placeholder="+994 XX XXX XX XX" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Şirkət və İstifadəçi -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-link-45deg"></i> Əlaqələr
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CompanyId" class="form-label">
                                        Şirkət <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="CompanyId" class="form-select" asp-items="companies">
                                        <option value="">Şirkət seçin...</option>
                                    </select>
                                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UserId" class="form-label">
                                        İstifadəçi <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="UserId" class="form-select" asp-items="users">
                                        <option value="">İstifadəçi seçin...</option>
                                    </select>
                                    <span asp-validation-for="UserId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Əlavə Məlumatlar -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-card-text"></i> Əlavə Məlumatlar
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Specialization" class="form-label">İxtisaslaşma</label>
                            <input asp-for="Specialization" class="form-control"
                                   placeholder="Məsələn: Riyaziyyat müəllimi" />
                            <span asp-validation-for="Specialization" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Biography" class="form-label">Bioqrafiya</label>
                            <textarea asp-for="Biography" class="form-control" rows="3"
                                      placeholder="Müəllim haqqında qısa məlumat..."></textarea>
                            <span asp-validation-for="Biography" class="text-danger"></span>
                        </div>

                        <!-- Şəkil -->
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label">Profil Şəkli</label>
                            <input asp-for="ImageFile" type="file" class="form-control"
                                   accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <small class="text-muted">Maksimum 5MB (JPG, PNG, GIF)</small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Aktiv
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}