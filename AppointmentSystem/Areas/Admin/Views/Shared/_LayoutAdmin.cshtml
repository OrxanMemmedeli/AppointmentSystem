@using AppointmentSystem.Services.Abstract
@inject IMenuService MenuService
@inject ICurrentUserService CurrentUserService
@inject ICompanyService CompanyService
@{
    var currentUserId = CurrentUserService.UserId ?? Guid.Empty;
    var userName = CurrentUserService.UserName ?? "Admin";
    var fullName = CurrentUserService.FullName ?? "Administrator";
    var userEmail = CurrentUserService.Email ?? "";
    var companyId = CurrentUserService.CompanyId;
    var userRoles = CurrentUserService.GetRoles().ToList();

    // Company məlumatı
    string companyName = "EduMeet System";
    if (companyId.HasValue)
    {
        var company = await CompanyService.GetCompanyByIdAsync(companyId.Value);
        if (company != null)
        {
            companyName = company.Name;
        }
    }

    // Dinamik menular - role-based filtrasiya ilə
    var userMenus = new List<AppointmentSystem.Areas.Admin.Models.ViewModels.MenuTreeViewModel>();
    if (currentUserId != Guid.Empty)
    {
        userMenus = await MenuService.GetUserMenusWithPermissionsAsync(currentUserId);
    }

    // User initials for avatar
    var initials = !string.IsNullOrEmpty(fullName)
        ? string.Concat(fullName.Split(' ').Select(s => s.FirstOrDefault()).Take(2)).ToUpper()
        : "A";

    // Current route - aktiv menu üçün (Server-Side)
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString()?.ToLower() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() ?? "";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons 1.11 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">

    @await RenderSectionAsync("Styles", required: false)

    <style>
        :root {
            --admin-primary: #2c3e50;
            --admin-secondary: #34495e;
            --admin-accent: #3498db;
            --admin-success: #27ae60;
            --admin-warning: #f39c12;
            --admin-danger: #e74c3c;
            --admin-light: #ecf0f1;
            --sidebar-width: 280px;
            --topbar-height: 70px;
            --transition-speed: 0.3s;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', 'Arial', sans-serif;
            font-size: 14px;
            background: #f5f7fa;
            overflow-x: hidden;
        }

        /* ==================== SIDEBAR ==================== */
        .admin-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: linear-gradient(180deg, var(--admin-primary) 0%, var(--admin-secondary) 100%);
            color: #ecf0f1;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1040;
            transition: transform var(--transition-speed) ease;
            box-shadow: 4px 0 15px rgba(0,0,0,0.15);
        }

            .admin-sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .admin-sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
                border-radius: 3px;
            }

                .admin-sidebar::-webkit-scrollbar-thumb:hover {
                    background: rgba(255,255,255,0.3);
                }

        /* Brand */
        .sidebar-brand {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.2);
        }

            .sidebar-brand i {
                font-size: 2.5rem;
                color: #ffd700;
                display: block;
                margin-bottom: 8px;
            }

            .sidebar-brand h4 {
                color: #ffd700;
                font-weight: 700;
                font-size: 1.4rem;
                margin: 0;
                text-transform: uppercase;
                letter-spacing: 1.5px;
            }

            .sidebar-brand small {
                color: rgba(255,255,255,0.7);
                font-size: 0.75rem;
                display: block;
                margin-top: 4px;
                font-weight: 400;
            }

        /* Company Info */
        .sidebar-company {
            padding: 15px 20px;
            background: rgba(0,0,0,0.15);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

            .sidebar-company .company-name {
                font-weight: 600;
                font-size: 0.9rem;
                color: #fff;
                margin-bottom: 4px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .sidebar-company .company-role {
                font-size: 0.75rem;
                color: rgba(255,255,255,0.65);
                padding-left: 24px;
            }

        /* Navigation */
        .sidebar-nav {
            padding: 15px 0;
        }

        .nav-section-title {
            padding: 15px 20px 8px;
            font-size: 0.7rem;
            font-weight: 700;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }

        .nav-item {
            margin: 2px 10px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 11px 15px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            border-radius: 8px;
            transition: all var(--transition-speed) ease;
            position: relative;
            overflow: hidden;
            font-size: 0.9rem;
        }

            .nav-link::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 3px;
                background: #ffd700;
                transform: scaleY(0);
                transition: transform var(--transition-speed) ease;
            }

            .nav-link:hover,
            .nav-link.active {
                background: rgba(255,255,255,0.12);
                color: #fff;
                transform: translateX(4px);
            }

                .nav-link.active::before {
                    transform: scaleY(1);
                }

            .nav-link i {
                font-size: 1.1rem;
                margin-right: 12px;
                width: 22px;
                text-align: center;
            }

            .nav-link .badge {
                margin-left: auto;
                font-size: 0.65rem;
                padding: 3px 7px;
            }

            .nav-link .bi-chevron-down {
                margin-left: auto;
                font-size: 0.8rem;
                transition: transform 0.3s ease;
            }

            .nav-link[aria-expanded="true"] .bi-chevron-down {
                transform: rotate(180deg);
            }

        /* Submenu */
        .nav-submenu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            padding-left: 15px;
        }

            .nav-submenu.show {
                max-height: 1000px;
            }

            .nav-submenu .nav-link {
                font-size: 0.85rem;
                padding: 9px 12px;
                margin: 1px 0;
            }

                .nav-submenu .nav-link i {
                    font-size: 0.9rem;
                }

        /* ==================== MAIN CONTENT ==================== */
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .admin-main {
            flex: 1;
            margin-left: var(--sidebar-width);
            transition: margin-left var(--transition-speed) ease;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Bar */
        .admin-topbar {
            position: sticky;
            top: 0;
            height: var(--topbar-height);
            background: #fff;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            z-index: 1030;
            border-bottom: 1px solid #e1e8ed;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            font-size: 1.4rem;
            color: var(--admin-primary);
            cursor: pointer;
            padding: 8px 10px;
            border-radius: 6px;
            transition: background var(--transition-speed);
            display: none;
        }

            .sidebar-toggle:hover {
                background: rgba(52, 73, 94, 0.08);
            }

        .page-title-wrapper h1 {
            margin: 0;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--admin-primary);
        }

        /* Breadcrumb */
        .admin-breadcrumb {
            background: transparent;
            padding: 0;
            margin: 5px 0 0 0;
            font-size: 0.82rem;
        }

            .admin-breadcrumb .breadcrumb-item a {
                color: #7f8c8d;
                text-decoration: none;
            }

                .admin-breadcrumb .breadcrumb-item a:hover {
                    color: var(--admin-accent);
                }

            .admin-breadcrumb .breadcrumb-item.active {
                color: var(--admin-primary);
                font-weight: 500;
            }

        /* Topbar Right */
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        /* Search */
        .topbar-search {
            position: relative;
            width: 320px;
        }

            .topbar-search input {
                width: 100%;
                padding: 10px 40px 10px 15px;
                border: 1px solid #e1e8ed;
                border-radius: 20px;
                font-size: 0.88rem;
                transition: all var(--transition-speed);
            }

                .topbar-search input:focus {
                    outline: none;
                    border-color: var(--admin-accent);
                    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
                }

            .topbar-search i {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #95a5a6;
            }

        /* Notification Button */
        .notification-btn {
            position: relative;
            padding: 10px;
            border-radius: 8px;
            background: transparent;
            border: none;
            cursor: pointer;
            transition: background var(--transition-speed);
        }

            .notification-btn:hover {
                background: rgba(52, 73, 94, 0.05);
            }

            .notification-btn i {
                font-size: 1.25rem;
                color: var(--admin-primary);
            }

            .notification-btn .badge {
                position: absolute;
                top: 6px;
                right: 6px;
                padding: 3px 6px;
                font-size: 0.65rem;
                background: var(--admin-danger);
                border-radius: 10px;
            }

        /* User Dropdown */
        .user-dropdown {
            position: relative;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 12px 6px 6px;
            border-radius: 25px;
            cursor: pointer;
            transition: background var(--transition-speed);
            border: 1px solid #e1e8ed;
        }

            .user-info:hover {
                background: rgba(52, 73, 94, 0.04);
                border-color: var(--admin-accent);
            }

        .user-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--admin-accent), var(--admin-primary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .user-details {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--admin-primary);
            line-height: 1.3;
        }

        .user-role {
            font-size: 0.72rem;
            color: #7f8c8d;
        }

        .user-dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            min-width: 240px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
            display: none;
            z-index: 1050;
            border: 1px solid #e1e8ed;
        }

            .user-dropdown-menu.show {
                display: block;
                animation: slideDown 0.3s ease;
            }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dropdown-header {
            padding: 15px;
            border-bottom: 1px solid #e1e8ed;
        }

            .dropdown-header .user-name {
                font-weight: 600;
                font-size: 0.95rem;
                color: var(--admin-primary);
            }

            .dropdown-header .user-email {
                font-size: 0.8rem;
                color: #7f8c8d;
                margin-top: 3px;
            }

        .dropdown-menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: var(--admin-primary);
            text-decoration: none;
            transition: background var(--transition-speed);
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
            font-size: 0.88rem;
        }

            .dropdown-menu-item:hover {
                background: rgba(52, 73, 94, 0.05);
            }

            .dropdown-menu-item i {
                width: 20px;
                font-size: 1.05rem;
            }

        .dropdown-divider {
            height: 1px;
            background: #e1e8ed;
            margin: 5px 0;
        }

        .dropdown-menu-item.text-danger {
            color: var(--admin-danger);
        }

            .dropdown-menu-item.text-danger:hover {
                background: rgba(231, 76, 60, 0.05);
            }

        /* Content Area */
        .admin-content {
            flex: 1;
            padding: 30px;
            background: #f5f7fa;
        }

        /* Alert Styles */
        .alert {
            border: none;
            border-radius: 8px;
            padding: 14px 18px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

            .alert i {
                margin-right: 10px;
                font-size: 1.1rem;
            }

        .alert-success {
            background: #d4edda;
            color: #155724;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
        }

        .alert-info {
            background: #d1ecf1;
            color: #0c5460;
        }

        .alert-warning {
            background: #fff3cd;
            color: #856404;
        }

        /* ==================== RESPONSIVE ==================== */
        @@media (max-width: 992px) {
            .topbar-search {
                width: 200px;
            }
        }

        @@media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

                .admin-sidebar.mobile-show {
                    transform: translateX(0);
                }

            .admin-main {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: block;
            }

            .topbar-search {
                display: none;
            }

            .user-details {
                display: none;
            }

            .page-title-wrapper h1 {
                font-size: 1.3rem;
            }

            .admin-content {
                padding: 20px 15px;
            }
        }

        /* Mobile Overlay */
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1035;
        }

            .sidebar-overlay.show {
                display: block;
            }

        /* Table enhancements */
        .table-responsive {
            max-height: 600px;
            overflow-y: auto;
        }

        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        /* Pagination styling */
        .pagination .page-link {
            color: #3498db;
        }

        .pagination .page-item.active .page-link {
            background-color: #3498db;
            border-color: #3498db;
        }

        /* Status badges */
        .badge {
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
    </style>
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar Overlay (Mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- ==================== SIDEBAR ==================== -->
        <aside class="admin-sidebar" id="adminSidebar">
            <!-- Brand -->
            <div class="sidebar-brand">
                <i class="bi bi-shield-lock-fill"></i>
                <h4>EduMeet</h4>
                <small>Admin Panel</small>
            </div>

            <!-- Company Info -->
            @if (companyId.HasValue)
            {
                <div class="sidebar-company">
                    <div class="company-name">
                        <i class="bi bi-building"></i>
                        <span>@companyName</span>
                    </div>
                    <div class="company-role">
                        @string.Join(" • ", userRoles)
                    </div>
                </div>
            }

            <!-- Navigation Menu -->
            <nav class="sidebar-nav">
                @if (userMenus != null && userMenus.Any())
                {
                    @foreach (var menu in userMenus.Where(m => m.IsVisible))
                    {
                        @if (menu.HasChildren)
                        {
                            var isParentActive = menu.Children.Any(c =>
                            c.ControllerName?.ToLower() == currentController);
                            <!-- Parent Menu with Children -->
                            <div class="nav-item">
                                <a href="javascript:void(0)"
                                   class="nav-link @(isParentActive ? "active" : "")"
                                   data-bs-toggle="collapse"
                                   data-bs-target="#submenu-@menu.Id"
                                   aria-expanded="@(isParentActive ? "true" : "false")">
                                    <i class="@(string.IsNullOrEmpty(menu.IconSVG) ? "bi bi-circle" : menu.IconSVG)"></i>
                                    <span>@menu.Name</span>
                                    <i class="bi bi-chevron-down"></i>
                                </a>
                                <div class="nav-submenu collapse @(isParentActive ? "show" : "")" id="submenu-@menu.Id">
                                    @foreach (var child in menu.Children.Where(c => c.IsVisible))
                                    {
                                        var isChildActive = child.ControllerName?.ToLower() == currentController;
                                        <a class="nav-link @(isChildActive ? "active" : "")"
                                           asp-area="@(child.AreaName ?? "Admin")"
                                           asp-controller="@child.ControllerName"
                                           asp-action="@(child.ActionName ?? "Index")">
                                            <i class="@(string.IsNullOrEmpty(child.IconSVG) ? "bi bi-circle" : child.IconSVG)"></i>
                                            <span>@child.Name</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            var isActive = menu.ControllerName?.ToLower() == currentController;
                            <!-- Single Menu Item -->
                            <div class="nav-item">
                                <a class="nav-link @(isActive ? "active" : "")"
                                   asp-area="@(menu.AreaName ?? "Admin")"
                                   asp-controller="@menu.ControllerName"
                                   asp-action="@(menu.ActionName ?? "Index")">
                                    <i class="@(string.IsNullOrEmpty(menu.IconSVG) ? "bi bi-circle" : menu.IconSVG)"></i>
                                    <span>@menu.Name</span>
                                </a>
                            </div>
                        }
                    }
                }
                else
                {
                    <!-- ========== FALLBACK STATIC MENU ========== -->
                    <!-- ƏSAS BÖLMƏ -->
                    <div class="nav-section-title">ƏSAS</div>

                    <div class="nav-item">
                        <a class="nav-link @(currentController == "dashboard" ? "active" : "")"
                           asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "company" ? "active" : "")"
                           asp-area="Admin" asp-controller="Company" asp-action="Index">
                            <i class="bi bi-building"></i>
                            <span>Şirkətlər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "teacher" ? "active" : "")"
                           asp-area="Admin" asp-controller="Teacher" asp-action="Index">
                            <i class="bi bi-person-badge"></i>
                            <span>Müəllimlər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "student" ? "active" : "")"
                           asp-area="Admin" asp-controller="Student" asp-action="Index">
                            <i class="bi bi-mortarboard"></i>
                            <span>Şagirdlər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "parent" ? "active" : "")"
                           asp-area="Admin" asp-controller="Parent" asp-action="Index">
                            <i class="bi bi-people"></i>
                            <span>Valideynlər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "schoolclass" ? "active" : "")"
                           asp-area="Admin" asp-controller="SchoolClass" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Siniflər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "subject" ? "active" : "")"
                           asp-area="Admin" asp-controller="Subject" asp-action="Index">
                            <i class="bi bi-book"></i>
                            <span>Fənlər</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "meeting" ? "active" : "")"
                           asp-area="Admin" asp-controller="Meeting" asp-action="Index">
                            <i class="bi bi-calendar-event"></i>
                            <span>Görüşlər</span>
                        </a>
                    </div>

                    <!-- İDARƏETMƏ BÖLMƏSI -->
                    <div class="nav-section-title">İDARƏETMƏ</div>

                    <div class="nav-item">
                        <a class="nav-link @(currentController == "role" ? "active" : "")"
                           asp-area="Admin" asp-controller="Role" asp-action="Index">
                            <i class="bi bi-shield-check"></i>
                            <span>Rollar</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "permission" ? "active" : "")"
                           asp-area="Admin" asp-controller="Permission" asp-action="Index">
                            <i class="bi bi-key"></i>
                            <span>İcazələr</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "parenttype" ? "active" : "")"
                           asp-area="Admin" asp-controller="ParentType" asp-action="Index">
                            <i class="bi bi-tag"></i>
                            <span>Valideyn Tipləri</span>
                        </a>
                    </div>
                    <div class="nav-item">
                        <a class="nav-link @(currentController == "studentparent" ? "active" : "")"
                           asp-area="Admin" asp-controller="StudentParent" asp-action="Index">
                            <i class="bi bi-link-45deg"></i>
                            <span>Şagird-Valideyn</span>
                        </a>
                    </div>
                }

                <!-- SİSTEM BÖLMƏSI - Həmişə Görünür -->
                <div class="nav-section-title">SİSTEM</div>
                <div class="nav-item">
                    <a class="nav-link @(currentController == "menu" ? "active" : "")"
                       asp-area="Admin" asp-controller="Menu" asp-action="Index">
                        <i class="bi bi-menu-button-wide"></i>
                        <span>Menyu İdarəsi</span>
                    </a>
                </div>
                <div class="nav-item">
                    <a class="nav-link @(currentController == "settings" ? "active" : "")"
                       asp-area="Admin" asp-controller="Settings" asp-action="Index">
                        <i class="bi bi-gear"></i>
                        <span>Tənzimləmələr</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- ==================== MAIN CONTENT ==================== -->
        <main class="admin-main" id="adminMain">
            <!-- Top Bar -->
            <div class="admin-topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="page-title-wrapper">
                        <h1>@ViewData["Title"]</h1>
                        @if (ViewData["Breadcrumbs"] != null)
                        {
                            <nav aria-label="breadcrumb">
                                <ol class="admin-breadcrumb breadcrumb mb-0">
                                    @foreach (var item in (List<(string Text, string? Url)>)ViewData["Breadcrumbs"])
                                    {
                                        @if (item.Url != null)
                                        {
                                            <li class="breadcrumb-item">
                                                <a href="@item.Url">@item.Text</a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li class="breadcrumb-item active" aria-current="page">@item.Text</li>
                                        }
                                    }
                                </ol>
                            </nav>
                        }
                    </div>
                </div>

                <div class="topbar-right">
                    <!-- Global Search -->
                    <div class="topbar-search">
                        <input type="text"
                               class="form-control"
                               placeholder="Axtar..."
                               id="globalSearch"
                               autocomplete="off">
                        <i class="bi bi-search"></i>
                    </div>

                    <!-- Notifications -->
                    <button class="notification-btn" onclick="showNotifications()" aria-label="Bildirişlər">
                        <i class="bi bi-bell"></i>
                        <span class="badge">3</span>
                    </button>

                    <!-- User Dropdown -->
                    <div class="user-dropdown">
                        <div class="user-info" onclick="toggleUserMenu()" role="button" tabindex="0">
                            <div class="user-avatar">@initials</div>
                            <div class="user-details">
                                <span class="user-name">@fullName</span>
                                <span class="user-role">@(userRoles.FirstOrDefault() ?? "Admin")</span>
                            </div>
                            <i class="bi bi-chevron-down"></i>
                        </div>

                        <div class="user-dropdown-menu" id="userDropdownMenu">
                            <div class="dropdown-header">
                                <div class="user-name">@fullName</div>
                                <div class="user-email">@userEmail</div>
                            </div>
                            <a href="#" class="dropdown-menu-item">
                                <i class="bi bi-person-circle"></i>
                                <span>Profil</span>
                            </a>
                            <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="dropdown-menu-item">
                                <i class="bi bi-gear"></i>
                                <span>Tənzimləmələr</span>
                            </a>
                            <a href="#" class="dropdown-menu-item">
                                <i class="bi bi-question-circle"></i>
                                <span>Kömək</span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Auth" asp-action="Logout" asp-area="" method="post" style="margin: 0;">
                                <button type="submit" class="dropdown-menu-item text-danger">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Çıxış</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Page Content -->
            <div class="admin-content">
                <!-- TempData Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["SuccessMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@TempData["ErrorMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>@TempData["InfoMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <span>@TempData["WarningMessage"]</span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Main Body Content -->
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toggle Sidebar (Mobile)
        function toggleSidebar() {
            const sidebar = document.getElementById('adminSidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('mobile-show');
            overlay.classList.toggle('show');
        }

        // Toggle User Menu
        function toggleUserMenu() {
            const menu = document.getElementById('userDropdownMenu');
            menu.classList.toggle('show');
        }

        // Show Notifications (Placeholder)
        function showNotifications() {
            alert('Bildirişlər funksiyası tezliklə əlavə ediləcək');
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(event) {
            const userDropdown = document.querySelector('.user-dropdown');
            const userMenu = document.getElementById('userDropdownMenu');
            if (!userDropdown.contains(event.target)) {
                userMenu.classList.remove('show');
            }
        });

        // Active menu highlight (JavaScript backup - Server-side artıq işləyir)
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.nav-link:not([data-bs-toggle])');

            // Server-side artıq active class qoyub, amma submenu açılması üçün JS lazımdır
            const activeLinks = document.querySelectorAll('.nav-link.active');
            activeLinks.forEach(link => {
                const parentSubmenu = link.closest('.nav-submenu');
                if (parentSubmenu) {
                    parentSubmenu.classList.add('show');
                    const parentToggle = document.querySelector(`[data-bs-target="#${parentSubmenu.id}"]`);
                    if (parentToggle) {
                        parentToggle.setAttribute('aria-expanded', 'true');
                        parentToggle.classList.add('active');
                    }
                }
            });

            // Submenu toggle functionality
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(toggle => {
                toggle.addEventListener('click', function() {
                    const target = document.querySelector(this.getAttribute('data-bs-target'));
                    if (target) {
                        target.classList.toggle('show');
                        this.setAttribute('aria-expanded', target.classList.contains('show'));
                    }
                });
            });
        });

        // Auto-hide alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(() => {
                const alerts = document.querySelectorAll('.alert.alert-dismissible');
                alerts.forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });

        // Global Search (Placeholder)
        document.getElementById('globalSearch')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                alert('Axtarış funksiyası tezliklə əlavə ediləcək: ' + this.value);
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
