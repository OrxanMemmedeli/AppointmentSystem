@model RoleViewModel
@{
    ViewData["Title"] = "Yeni Rol";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-shield-lock"></i> Yeni Rol Yarat</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Rol Adı <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg"
                                   placeholder="Administrator" autofocus />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">
                                Rol Kodu
                            </label>
                            <input asp-for="Code" class="form-control text-uppercase"
                                   placeholder="ADMIN" maxlength="50" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Yalnız böyük hərflər və alt xətt istifadə edin (məs: ADMIN, TEACHER_MANAGER)
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Təsvir</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Bu rolun məqsədi və vəzifələri haqqında qısa məlumat..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Priority" class="form-label">
                                        Prioritet <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Priority" type="number" class="form-control"
                                           min="0" max="100" value="0" />
                                    <span asp-validation-for="Priority" class="text-danger"></span>
                                    <small class="form-text text-muted">
                                        0-100 arası (yüksək rəqəm = yüksək prioritet)
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsSystemRole" class="form-check-input"
                                           type="checkbox" role="switch" />
                                    <label asp-for="IsSystemRole" class="form-check-label">
                                        <i class="bi bi-gear"></i> Sistem Rolu
                                    </label>
                                    <div class="form-text">
                                        Sistem rolları silinə və bəzi dəyişikliklərə məruz qala bilməz
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsActive" class="form-check-input"
                                           type="checkbox" role="switch" checked />
                                    <label asp-for="IsActive" class="form-check-label">
                                        <i class="bi bi-check-circle"></i> Aktiv
                                    </label>
                                    <div class="form-text">
                                        Deaktiv rollar istifadəçilərə təyin edilə bilməz
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Məlumat Paneli -->
            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-lightbulb"></i> Məlumat
                    </h6>
                    <ul class="small mb-0">
                        <li><strong>Rol Adı:</strong> İstifadəçilərə göstəriləcək ad</li>
                        <li><strong>Rol Kodu:</strong> Sistem daxilində istifadə üçün unikal identifikator</li>
                        <li><strong>Prioritet:</strong> Rollar arasında iyerarxiya yaradır (yüksək prioritet = daha çox səlahiyyət)</li>
                        <li><strong>Sistem Rolu:</strong> Kritik sistem rolları üçün əlavə qorunma</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Kod inputunu avtomatik uppercase et
        document.addEventListener('DOMContentLoaded', function() {
            const codeInput = document.getElementById('@Html.IdFor(m => m.Code)');
            if (codeInput) {
                codeInput.addEventListener('input', function() {
                    this.value = this.value.toUpperCase().replace(/[^A-Z_]/g, '');
                });
            }
        });
    </script>
}