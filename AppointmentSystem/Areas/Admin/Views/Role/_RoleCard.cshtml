@model RoleListViewModel

<div class="card h-100 shadow-sm hover-shadow">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">
                <i class="bi bi-shield-lock text-primary"></i>
                @Model.Name
            </h5>
            @if (Model.IsSystemRole)
            {
                <span class="badge bg-info">Sistem</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Code))
        {
            <p class="text-muted small mb-2">
                <i class="bi bi-code"></i> <code>@Model.Code</code>
            </p>
        }

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text small text-muted mb-3">
                @Model.Description
            </p>
        }

        <div class="row g-2 mb-3">
            <div class="col-6">
                <div class="border rounded p-2 text-center">
                    <div class="h5 mb-0 text-primary">@Model.UserCount</div>
                    <small class="text-muted">İstifadəçi</small>
                </div>
            </div>
            <div class="col-6">
                <div class="border rounded p-2 text-center">
                    <div class="h5 mb-0 text-success">@Model.PermissionCount</div>
                    <small class="text-muted">İcazə</small>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-secondary">Prioritet: @Model.Priority</span>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Aktiv</span>
                }
                else
                {
                    <span class="badge bg-danger">Deaktiv</span>
                }
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <div class="btn-group w-100">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-sm btn-outline-primary">
                <i class="bi bi-pencil"></i> Redaktə
            </a>
            @if (!Model.IsSystemRole)
            {
                <form asp-action="ToggleStatus" asp-route-id="@Model.Id"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-@(Model.IsActive ? "pause" : "play")-circle"></i>
                    </button>
                </form>
                <a asp-action="Delete" asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash"></i> Sil
                </a>
            }
        </div>
    </div>
</div>

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease-in-out;
    }

        .hover-shadow:hover {
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
</style>