@model List<ParentListViewModel>
@{
    ViewData["Title"] = "Valideyn İdarəetməsi";
    var filterCompanyId = ViewData["FilterCompanyId"] as Guid?;
    var companies = ViewData["Companies"] as List<SelectListItem>;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Valideyn İdarəetməsi</h2>
        <a asp-action="Create" asp-route-companyId="@filterCompanyId" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Valideyn
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Valideyn</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-people text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(p => p.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">İstifadəçi Hesabı Var</h6>
                            <h3 class="mb-0">@Model.Count(p => p.HasUser)</h3>
                        </div>
                        <i class="bi bi-person-check text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Uşaq</h6>
                            <h3 class="mb-0">@Model.Sum(p => p.ChildrenCount)</h3>
                        </div>
                        <i class="bi bi-person-hearts text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="Ad, soyad və ya FIN kod ilə axtar...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterCompany">
                        <option value="">Bütün Şirkətlər</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Value" selected="@(company.Value == filterCompanyId?.ToString())">
                                @company.Text
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="filterStatus">
                        <option value="">Bütün Statuslar</option>
                        <option value="active">Aktiv</option>
                        <option value="inactive">Deaktiv</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="filterUser">
                        <option value="">Hamısı</option>
                        <option value="hasUser">İstifadəçi hesabı var</option>
                        <option value="noUser">İstifadəçi hesabı yox</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-outline-secondary w-100" id="clearFilters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="parentTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Ad Soyad</th>
                            <th>FIN Kod</th>
                            <th>Əlaqə</th>
                            <th>Şirkət</th>
                            <th>Uşaqlar</th>
                            <th>Hesab</th>
                            <th>Status</th>
                            <th style="width: 180px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parent in Model)
                        {
                            <tr data-company="@parent.CompanyId"
                                data-status="@(parent.IsActive ? "active" : "inactive")"
                                data-user="@(parent.HasUser ? "hasUser" : "noUser")">
                                <td>
                                    @if (!string.IsNullOrEmpty(parent.ImagePath))
                                    {
                                        <img src="@parent.ImagePath" alt="@parent.FullName"
                                             class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center"
                                             style="width: 50px; height: 50px; font-size: 1.2rem;">
                                            @parent.FirstName.Substring(0, 1).ToUpper()@parent.LastName.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@parent.FullName</strong>
                                </td>
                                <td>
                                    <code>@parent.FinCode</code>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(parent.Email))
                                        {
                                            <i class="bi bi-envelope"></i> 
                                            @parent.Email
                                    
                                            <br />
                                        }
                                        @if (!string.IsNullOrEmpty(parent.Phone))
                                        {
                                            <i class="bi bi-telephone"></i> 
                                            @parent.Phone
                                        }
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">@parent.CompanyName</small>
                                </td>
                                <td>
                                    <span class="badge bg-info" title="Uşaq sayı">
                                        <i class="bi bi-person-hearts"></i> @parent.ChildrenCount
                                    </span>
                                </td>
                                <td>
                                    @if (parent.HasUser)
                                    {
                                        <span class="badge bg-success" title="İstifadəçi hesabı var">
                                            <i class="bi bi-person-check"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" title="İstifadəçi hesabı yox">
                                            <i class="bi bi-person-x"></i>
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (parent.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@parent.Id"
                                           class="btn btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@parent.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@parent.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(parent.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(parent.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@parent.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ valideyn qeydiyyatdan keçməyib</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Valideyni Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const filterCompany = document.getElementById('filterCompany');
            const filterStatus = document.getElementById('filterStatus');
            const filterUser = document.getElementById('filterUser');
            const clearFilters = document.getElementById('clearFilters');
            const tableRows = document.querySelectorAll('#parentTable tbody tr');

            function applyFilters() {
                const searchTerm = searchInput.value.toLowerCase();
                const companyValue = filterCompany.value;
                const statusValue = filterStatus.value;
                const userValue = filterUser.value;

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const company = row.dataset.company;
                    const status = row.dataset.status;
                    const user = row.dataset.user;

                    let show = true;

                    if (searchTerm && !text.includes(searchTerm)) show = false;
                    if (companyValue && company !== companyValue) show = false;
                    if (statusValue && status !== statusValue) show = false;
                    if (userValue && user !== userValue) show = false;

                    row.style.display = show ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', applyFilters);
            filterCompany.addEventListener('change', function() {
                if (this.value) {
                    window.location.href = '@Url.Action("Index")?companyId=' + this.value;
                } else {
                    window.location.href = '@Url.Action("Index")';
                }
            });
            filterStatus.addEventListener('change', applyFilters);
            filterUser.addEventListener('change', applyFilters);

            clearFilters.addEventListener('click', function() {
                searchInput.value = '';
                filterStatus.value = '';
                filterUser.value = '';
                applyFilters();
            });
        });
    </script>
}