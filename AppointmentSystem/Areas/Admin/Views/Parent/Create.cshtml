@model ParentViewModel
@{
    ViewData["Title"] = "Yeni Valideyn";
    var companies = ViewData["Companies"] as List<SelectListItem>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-person-plus"></i> Yeni Valideyn Qeydiyyatı</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Şəxsi Məlumatlar -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-person"></i> Şəxsi Məlumatlar
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FirstName" class="form-label">
                                        Ad <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FirstName" class="form-control"
                                           placeholder="Məsələn: Elxan" autofocus />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LastName" class="form-label">
                                        Soyad <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="LastName" class="form-control"
                                           placeholder="Məsələn: Məmmədov" />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="FinCode" class="form-label">
                                        FIN Kod <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="FinCode" class="form-control text-uppercase"
                                           placeholder="ABC1234" maxlength="7" />
                                    <span asp-validation-for="FinCode" class="text-danger"></span>
                                    <small class="text-muted">7 simvol: böyük hərflər və rəqəmlər</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CompanyId" class="form-label">
                                        Şirkət/Məktəb <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="CompanyId" asp-items="companies" class="form-select">
                                        <option value="">Şirkət seçin</option>
                                    </select>
                                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Əlaqə Məlumatları -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-telephone"></i> Əlaqə Məlumatları
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">Email</label>
                                    <input asp-for="Email" type="email" class="form-control"
                                           placeholder="elxan@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Phone" class="form-label">Telefon</label>
                                    <input asp-for="Phone" type="tel" class="form-control"
                                           placeholder="+994 XX XXX XX XX" />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">
                                Əlavə Telefon
                            </label>
                            <input asp-for="PhoneNumber" type="tel" class="form-control"
                                   placeholder="+994 XX XXX XX XX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Şəkil -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-image"></i> Profil Şəkli
                        </h5>

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label">Şəkil Yüklə</label>
                            <input asp-for="ImageFile" type="file" class="form-control"
                                   accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                            <small class="text-muted">
                                Maksimum 5MB, yalnız şəkil faylları (JPG, PNG, GIF)
                            </small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input"
                                   type="checkbox" role="switch" checked />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Aktiv
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Məlumat Kartı -->
            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-lightbulb"></i> Məlumat
                    </h6>
                    <ul class="small mb-0">
                        <li><strong>FIN Kod:</strong> Şəxsiyyət vəsiqəsindəki 7 simvollu kod</li>
                        <li><strong>Email:</strong> Valideyn portalına giriş üçün istifadə oluna bilər</li>
                        <li><strong>Telefon:</strong> Bildirişlər və əlaqə üçün</li>
                        <li>Valideyn yaradıldıqdan sonra ona şagird əlavə edə biləcəksiniz</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // FIN kod inputunu uppercase et
            const finCodeInput = document.getElementById('@Html.IdFor(m => m.FinCode)');
            if (finCodeInput) {
                finCodeInput.addEventListener('input', function() {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
                });
            }

            // Şəkil önizləmə
            const imageInput = document.getElementById('@Html.IdFor(m => m.ImageFile)');
            if (imageInput) {
                imageInput.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            // Önizləmə göstər (əgər div varsa)
                            const preview = document.getElementById('imagePreview');
                            if (preview) {
                                preview.src = e.target.result;
                                preview.style.display = 'block';
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
}