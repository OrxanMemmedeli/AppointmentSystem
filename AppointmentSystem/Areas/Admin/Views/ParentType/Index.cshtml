@model List<ParentTypeListViewModel>
@{
    ViewData["Title"] = "Valideyn Növləri";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-diagram-3"></i> Valideyn Növləri</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Valideyn Növü
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Növ</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-diagram-3 text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(pt => pt.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi İstifadə</h6>
                            <h3 class="mb-0">@Model.Sum(pt => pt.UsageCount)</h3>
                        </div>
                        <i class="bi bi-person-hearts text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ad</th>
                            <th>Növ</th>
                            <th>Açıqlama</th>
                            <th>İstifadə</th>
                            <th>Status</th>
                            <th style="width: 150px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var type in Model)
                        {
                            <tr>
                                <td><strong>@type.Name</strong></td>
                                <td>
                                    <span class="badge bg-primary">@type.TypeDisplay</span>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @(type.Description ?? "-")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-info">
                                        <i class="bi bi-link-45deg"></i> @type.UsageCount
                                    </span>
                                </td>
                                <td>
                                    @if (type.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@type.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@type.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(type.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(type.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@type.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ valideyn növü yaradılmayıb</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Növü Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>