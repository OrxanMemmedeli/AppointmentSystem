@model List<MenuTreeViewModel>
@{
    ViewData["Title"] = "Menyu Ağacı";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-diagram-3"></i> Menyu Ağacı</h2>
        <div class="btn-group">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Menyu
            </a>
            <a asp-action="Index" asp-route-view="table" class="btn btn-outline-secondary">
                <i class="bi bi-table"></i> Cədvəl Görünüşü
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="menu-tree">
                    @foreach (var menu in Model)
                    {
                        <partial name="_MenuTreeNode" model="menu" />
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ menyu yaradılmayıb</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Menyunu Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .menu-tree {
        font-family: 'Courier New', monospace;
    }

    .menu-tree-node {
        padding: 8px;
        margin: 4px 0;
        border-left: 3px solid #dee2e6;
        transition: all 0.3s ease;
    }

        .menu-tree-node:hover {
            background-color: #f8f9fa;
            border-left-color: #0d6efd;
        }

    .menu-tree-children {
        margin-left: 30px;
        border-left: 1px dashed #dee2e6;
        padding-left: 10px;
    }
</style>