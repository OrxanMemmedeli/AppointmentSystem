@model List<AppointmentSystem.Areas.Admin.Models.ViewModels.MenuListViewModel>
@{
    ViewData["Title"] = "Menyu İdarəsi";
    var viewType = ViewData["ViewType"]?.ToString() ?? "table";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-menu-button-wide text-primary me-2"></i>
                Menyu İdarəsi
            </h4>
            <p class="text-muted mb-0">Sistem menyularını idarə edin</p>
        </div>
        <div class="d-flex gap-2">
            <div class="btn-group">
                <a asp-action="Index" asp-route-view="table"
                   class="btn btn-outline-secondary @(viewType == "table" ? "active" : "")">
                    <i class="bi bi-list"></i>
                </a>
                <a asp-action="Index" asp-route-view="tree"
                   class="btn btn-outline-secondary @(viewType == "tree" ? "active" : "")">
                    <i class="bi bi-diagram-3"></i>
                </a>
            </div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Yeni Menyu
            </a>
        </div>
    </div>

    <!-- Menus Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">Sıra</th>
                                <th>Ad</th>
                                <th>Kod</th>
                                <th>Controller/Action</th>
                                <th>Tip</th>
                                <th class="text-center">Görünür</th>
                                <th class="text-center">Status</th>
                                <th class="text-end" style="width: 150px;">Əməliyyatlar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var menu in Model.OrderBy(m => m.Level).ThenBy(m => m.OrderIndex))
                            {
                                var indent = new string('─', menu.Level * 2);
                                <tr>
                                    <td>@menu.OrderIndex</td>
                                    <td>
                                        @if (menu.Level > 0)
                                        {
                                            <span class="text-muted">@indent </span>
                                        }
                                        <i class="@(menu.IconSVG ?? "bi-circle") me-2"></i>
                                        <strong>@menu.Name</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.Code))
                                        {
                                            <code>@menu.Code</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(menu.ControllerName))
                                        {
                                            <code>@menu.AreaName/@menu.ControllerName/@menu.ActionName</code>
                                        }
                                        else if (!string.IsNullOrEmpty(menu.Url))
                                        {
                                            <a href="@menu.Url" target="_blank" class="text-decoration-none">
                                                <i class="bi bi-box-arrow-up-right"></i> @menu.Url
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@menu.Type</span>
                                    </td>
                                    <td class="text-center">
                                        @if (menu.IsVisible)
                                        {
                                            <i class="bi bi-eye text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-eye-slash text-muted"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (menu.IsActive)
                                        {
                                            <span class="badge bg-success">Aktiv</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Deaktiv</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@menu.Id"
                                               class="btn btn-outline-primary" title="Redaktə">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@menu.Id" />
                                                <button type="submit"
                                                        class="btn btn-outline-warning"
                                                        title="@(menu.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                    <i class="bi @(menu.IsActive ? "bi-pause" : "bi-play")"></i>
                                                </button>
                                            </form>
                                            <a asp-action="Delete" asp-route-id="@menu.Id"
                                               class="btn btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-menu-button-wide display-4 text-muted"></i>
                    <p class="text-muted mt-3">Heç bir menyu tapılmadı</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i> İlk Menyu Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>
