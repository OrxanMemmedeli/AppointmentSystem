@model StudentParentViewModel
@{
    ViewData["Title"] = "Yeni Şagird-Valideyn Əlaqəsi";
    var students = ViewData["Students"] as List<SelectListItem>;
    var parents = ViewData["Parents"] as List<SelectListItem>;
    var parentTypes = ViewData["ParentTypes"] as List<SelectListItem>;
    var relationTypes = ViewData["RelationTypes"] as List<SelectListItem>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-link-45deg"></i> Yeni Şagird-Valideyn Əlaqəsi</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Şagird və Valideyn Seçimi -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-people"></i> Əsas Məlumatlar
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="StudentId" class="form-label">
                                        Şagird <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="StudentId" asp-items="students" class="form-select">
                                        <option value="">Şagird seçin</option>
                                    </select>
                                    <span asp-validation-for="StudentId" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ParentId" class="form-label">
                                        Valideyn <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="ParentId" asp-items="parents" class="form-select">
                                        <option value="">Valideyn seçin</option>
                                    </select>
                                    <span asp-validation-for="ParentId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Qohumluq Məlumatları -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-heart"></i> Qohumluq Məlumatları
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RelationType" class="form-label">
                                        Qohumluq Növü <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="RelationType" asp-items="relationTypes" class="form-select">
                                        <option value="">Seçin</option>
                                    </select>
                                    <span asp-validation-for="RelationType" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ParentTypeId" class="form-label">
                                        Valideyn Növü <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="ParentTypeId" asp-items="parentTypes" class="form-select">
                                        <option value="">Seçin</option>
                                    </select>
                                    <span asp-validation-for="ParentTypeId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Əlavə Parametrlər -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsPrimaryContact" class="form-check-input"
                                           type="checkbox" role="switch" />
                                    <label asp-for="IsPrimaryContact" class="form-check-label">
                                        <i class="bi bi-star"></i> Əsas valideyn (Primary Contact)
                                    </label>
                                    <br />
                                    <small class="text-muted">
                                        Əsas valideyn bildirişləri birinci alır
                                    </small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check form-switch mb-3">
                                    <input asp-for="IsActive" class="form-check-input"
                                           type="checkbox" role="switch" checked />
                                    <label asp-for="IsActive" class="form-check-label">
                                        <i class="bi bi-check-circle"></i> Aktiv
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Məlumat Kartı -->
            <div class="card mt-3 border-info">
                <div class="card-body">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-lightbulb"></i> Məlumat
                    </h6>
                    <ul class="small mb-0">
                        <li><strong>Qohumluq Növü:</strong> Valideyinin şagirdlə olan əlaqəsi (Ata, Ana və s.)</li>
                        <li><strong>Valideyn Növü:</strong> Sistemdə qeydiyyatdan keçmiş növlər</li>
                        <li><strong>Əsas Valideyn:</strong> Hər şagird üçün yalnız 1 əsas valideyn ola bilər</li>
                        <li>Əsas valideyn bildirişləri və məktəbdən gələn məlumatları birinci alır</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}