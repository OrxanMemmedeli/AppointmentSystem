@model CompanyViewModel
@{
    ViewData["Title"] = "Şirkət Redaktəsi";
    var companySubjects = ViewBag.CompanySubjects as List<SubjectListViewModel> ?? new List<SubjectListViewModel>();
    var companyUsers = ViewBag.CompanyUsers as List<CompanyUserListViewModel> ?? new List<CompanyUserListViewModel>();
    var allSubjects = ViewBag.AllSubjects as List<SelectListItem> ?? new List<SelectListItem>();
    var allUsers = ViewBag.AllUsers as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Əsas Məlumatlar Card -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Şirkət/Məktəb Redaktə Et</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Cari Logo və Background -->
                        @if (!string.IsNullOrEmpty(Model.LogoPath) || !string.IsNullOrEmpty(Model.BackgroundImagePath))
                        {
                            <div class="alert alert-info mb-4">
                                <h6 class="mb-3">Cari Şəkillər:</h6>
                                <div class="row">
                                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                                    {
                                        <div class="col-md-6">
                                            <strong>Logo:</strong><br />
                                            <img src="@Model.LogoPath" alt="Logo"
                                                 class="img-thumbnail mt-2" style="max-width: 150px;" />
                                            <br />
                                            <form asp-action="DeleteLogo" asp-route-id="@Model.Id"
                                                  method="post" class="d-inline mt-2">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Logonu silmək istədiyinizdən əminsiniz?')">
                                                    <i class="bi bi-trash"></i> Logonu sil
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.BackgroundImagePath))
                                    {
                                        <div class="col-md-6">
                                            <strong>Arxa fon:</strong><br />
                                            <img src="@Model.BackgroundImagePath" alt="Background"
                                                 class="img-thumbnail mt-2" style="max-width: 150px;" />
                                            <br />
                                            <form asp-action="DeleteBackgroundImage" asp-route-id="@Model.Id"
                                                  method="post" class="d-inline mt-2">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Arxa fonu silmək istədiyinizdən əminsiniz?')">
                                                    <i class="bi bi-trash"></i> Arxa fonu sil
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Əsas Məlumatlar -->
                        <h5 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-info-circle"></i> Əsas Məlumatlar
                        </h5>

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Name" class="form-label">
                                        Şirkət/Məktəb Adı <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Name" class="form-control"
                                           placeholder="Məsələn: Təhsil Mərkəzi" autofocus />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Code" class="form-label">
                                        Kod <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Code" class="form-control text-uppercase"
                                           placeholder="TM001" />
                                    <span asp-validation-for="Code" class="text-danger"></span>
                                    <small class="text-muted">Unikal sistem kodu</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">
                                        Email <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Email" type="email" class="form-control"
                                           placeholder="info@mekteb.az" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Website" class="form-label">Web Sayt</label>
                                    <input asp-for="Website" type="url" class="form-control"
                                           placeholder="https://mekteb.az" />
                                    <span asp-validation-for="Website" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">
                                        Əlavə Telefon
                                    </label>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control"
                                           placeholder="+994 XX XXX XX XX" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Ünvan -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-geo-alt"></i> Ünvan Məlumatları
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Ünvan</label>
                            <textarea asp-for="Address" class="form-control" rows="2"
                                      placeholder="Tam ünvan"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="MapUrl" class="form-label">
                                        Xəritə URL (Google Maps)
                                    </label>
                                    <input asp-for="MapUrl" type="url" class="form-control"
                                           placeholder="https://maps.google.com/..." />
                                    <span asp-validation-for="MapUrl" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="MapCoordinates" class="form-label">
                                        Koordinatlar
                                    </label>
                                    <input asp-for="MapCoordinates" class="form-control"
                                           placeholder="40.4093, 49.8671" />
                                    <span asp-validation-for="MapCoordinates" class="text-danger"></span>
                                    <small class="text-muted">Enlik, Uzunluq</small>
                                </div>
                            </div>
                        </div>

                        <!-- Yeni Şəkillər -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-image"></i> Yeni Şəkillər Yüklə
                        </h5>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LogoFile" class="form-label">Yeni Logo</label>
                                    <input asp-for="LogoFile" type="file" class="form-control"
                                           accept="image/*" />
                                    <span asp-validation-for="LogoFile" class="text-danger"></span>
                                    <small class="text-muted">Maksimum 5MB (JPG, PNG, GIF)</small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BackgroundImageFile" class="form-label">
                                        Yeni Arxa fon şəkli
                                    </label>
                                    <input asp-for="BackgroundImageFile" type="file" class="form-control"
                                           accept="image/*" />
                                    <span asp-validation-for="BackgroundImageFile" class="text-danger"></span>
                                    <small class="text-muted">Maksimum 10MB (JPG, PNG, GIF)</small>
                                </div>
                            </div>
                        </div>

                        <!-- İş Saatları -->
                        <h5 class="border-bottom pb-2 mb-3 mt-4">
                            <i class="bi bi-clock"></i> İş Saatları və Parametrlər
                        </h5>

                        <div class="row">
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="DefaultStartTime" class="form-label">
                                        İş Başlanğıc Saatı
                                    </label>
                                    <input asp-for="DefaultStartTime" type="time" class="form-control" />
                                    <span asp-validation-for="DefaultStartTime" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="DefaultEndTime" class="form-label">
                                        İş Bitmə Saatı
                                    </label>
                                    <input asp-for="DefaultEndTime" type="time" class="form-control" />
                                    <span asp-validation-for="DefaultEndTime" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="DefaultMeetingDuration" class="form-label">
                                        Görüş Müddəti (dəq)
                                    </label>
                                    <input asp-for="DefaultMeetingDuration" type="number"
                                           class="form-control" min="5" max="480" />
                                    <span asp-validation-for="DefaultMeetingDuration" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label asp-for="DefaultBreakDuration" class="form-label">
                                        Fasilə (dəq)
                                    </label>
                                    <input asp-for="DefaultBreakDuration" type="number"
                                           class="form-control" min="0" max="120" />
                                    <span asp-validation-for="DefaultBreakDuration" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Təsvir -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Təsvir</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Şirkət/məktəb haqqında qısa məlumat..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input"
                                   type="checkbox" role="switch" />
                            <label asp-for="IsActive" class="form-check-label">
                                <i class="bi bi-check-circle"></i> Aktiv
                            </label>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Geri
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-save"></i> Dəyişiklikləri Yadda Saxla
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ✅ Şirkət Fənləri (Company Subjects) -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-book"></i> Şirkət Fənləri</h5>
                    <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#subjectSection">
                        <i class="bi bi-plus-circle"></i> Fənn Əlavə Et
                    </button>
                </div>

                <div class="collapse" id="subjectSection">
                    <div class="card-body">
                        <form asp-action="AssignSubject" method="post" class="row g-3">
                            <input type="hidden" name="companyId" value="@Model.Id" />

                            <div class="col-md-10">
                                <select name="subjectId" class="form-select" required>
                                    <option value="">Fənn seçin...</option>
                                    @if (allSubjects != null && allSubjects.Any())
                                    {
                                        @foreach (var subject in allSubjects)
                                        {
                                            <option value="@subject.Value">@subject.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-plus"></i> Əlavə Et
                                </button>
                            </div>

                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    @if (companySubjects != null && companySubjects.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Fənn Adı</th>
                                        <th>Kod</th>
                                        <th>Status</th>
                                        <th>Əməliyyatlar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var index = 1;
                                    }
                                    @foreach (var subject in companySubjects)
                                    {
                                        <tr>
                                            <td>@(index++)</td>
                                            <td>@subject.Name</td>
                                            <td><code>@subject.Code</code></td>
                                            <td>
                                                <span class="badge bg-@(subject.IsActive ? "success" : "secondary")">
                                                    @(subject.IsActive ? "Aktiv" : "Deaktiv")
                                                </span>
                                            </td>
                                            <td>
                                                <form asp-action="RemoveSubject" method="post" class="d-inline">
                                                    <input type="hidden" name="companyId" value="@Model.Id" />
                                                    <input type="hidden" name="subjectId" value="@subject.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Bu fənni çıxarmaq istədiyinizə əminsiniz?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Bu şirkətə hələ fənn əlavə edilməyib.
                        </div>
                    }
                </div>
            </div>

            <!-- ✅ Şirkət İstifadəçiləri (Company Users) - TEK SECTION -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Şirkət İstifadəçiləri</h5>
                    <button type="button" class="btn btn-sm btn-light" data-bs-toggle="collapse" data-bs-target="#userSection">
                        <i class="bi bi-plus-circle"></i> İstifadəçi Əlavə Et
                    </button>
                </div>

                <div class="collapse" id="userSection">
                    <div class="card-body">
                        <form asp-action="AssignUser" method="post" class="row g-3">
                            <input type="hidden" name="companyId" value="@Model.Id" />

                            <div class="col-md-8">
                                <select name="userId" class="form-select" required>
                                    <option value="">İstifadəçi seçin...</option>
                                    @if (allUsers != null && allUsers.Any())
                                    {
                                        @foreach (var user in allUsers)
                                        {
                                            <option value="@user.Value">@user.Text</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="isManager" id="isManager">
                                    <label class="form-check-label" for="isManager">Manager</label>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="bi bi-plus"></i> Əlavə Et
                                </button>
                            </div>

                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                </div>

                <div class="card-body">
                    @if (companyUsers != null && companyUsers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>İstifadəçi</th>
                                        <th>Email</th>
                                        <th>Manager</th>
                                        <th>Status</th>
                                        <th>Əməliyyatlar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var userIndex = 1;
                                    }
                                    @foreach (var user in companyUsers)
                                    {
                                        <tr>
                                            <td>@(userIndex++)</td>
                                            <td>
                                                <strong>@user.UserFullName</strong><br />
                                                <small class="text-muted">@user.UserName</small>
                                            </td>
                                            <td>@user.UserEmail</td>
                                            <td>
                                                <span class="badge bg-@(user.IsManager ? "warning" : "secondary")">
                                                    @(user.IsManager ? "Manager" : "İstifadəçi")
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-@(user.IsActive ? "success" : "danger")">
                                                    @(user.IsActive ? "Aktiv" : "Deaktiv")
                                                </span>
                                            </td>
                                            <td>
                                                <form asp-action="ToggleManagerStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="companyId" value="@Model.Id" />
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning" title="Manager statusunu dəyiş">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="RemoveUser" method="post" class="d-inline">
                                                    <input type="hidden" name="companyId" value="@Model.Id" />
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Bu istifadəçini çıxarmaq istədiyinizə əminsiniz?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> Bu şirkətə hələ istifadəçi əlavə edilməyib.
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Kod inputunu uppercase et
            const codeInput = document.getElementById('@Html.IdFor(m => m.Code)');
            if (codeInput) {
                codeInput.addEventListener('input', function() {
                    this.value = this.value.toUpperCase().replace(/[^A-Z0-9_]/g, '');
                });
            }
        });
    </script>
}