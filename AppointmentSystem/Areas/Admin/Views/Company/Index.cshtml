@model List<CompanyListViewModel>
@{
    ViewData["Title"] = "Şirkət/Məktəb İdarəetməsi";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-building"></i> Şirkət/Məktəb İdarəetməsi</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Şirkət
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistika Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Şirkət</h6>
                            <h3 class="mb-0">@Model.Count</h3>
                        </div>
                        <i class="bi bi-building text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Aktiv</h6>
                            <h3 class="mb-0">@Model.Count(c => c.IsActive)</h3>
                        </div>
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Şagird</h6>
                            <h3 class="mb-0">@Model.Sum(c => c.StudentCount)</h3>
                        </div>
                        <i class="bi bi-people text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Ümumi Müəllim</h6>
                            <h3 class="mb-0">@Model.Sum(c => c.TeacherCount)</h3>
                        </div>
                        <i class="bi bi-person-badge text-warning" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-5">
                    <input type="text" class="form-control" id="searchInput"
                           placeholder="Şirkət adı, kod və ya email ilə axtar...">
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="filterStatus">
                        <option value="">Bütün Statuslar</option>
                        <option value="active">Aktiv</option>
                        <option value="inactive">Deaktiv</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-outline-secondary w-100" id="clearFilters">
                        <i class="bi bi-x-circle"></i> Təmizlə
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="companyTable">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Şirkət</th>
                            <th>Kod</th>
                            <th>Əlaqə</th>
                            <th>Ünvan</th>
                            <th>Statistika</th>
                            <th>Status</th>
                            <th style="width: 200px;">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var company in Model)
                        {
                            <tr data-status="@(company.IsActive ? "active" : "inactive")">
                                <td>
                                    @if (!string.IsNullOrEmpty(company.LogoPath))
                                    {
                                        <img src="@company.LogoPath" alt="@company.Name"
                                             class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
                                             style="width: 50px; height: 50px; font-size: 1.5rem;">
                                            @company.Name.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                </td>
                                <td>
                                    <strong>@company.Name</strong>
                                </td>
                                <td>
                                    <code>@company.Code</code>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(company.Email))
                                        {
                                            <i class="bi bi-envelope"></i> @company.Email

                                            <br />
                                        }
                                        @if (!string.IsNullOrEmpty(company.Phone))
                                        {
                                            <i class="bi bi-telephone"></i> @company.Phone
                                        }
                                    </div>
                                </td>
                                <td>
                                    <small class="text-muted">@(company.Address ?? "-")</small>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="badge bg-primary" title="Şagirdlər">
                                            <i class="bi bi-people"></i> @company.StudentCount
                                        </span>
                                        <span class="badge bg-success" title="Müəllimlər">
                                            <i class="bi bi-person-badge"></i> @company.TeacherCount
                                        </span>
                                        <span class="badge bg-info" title="Siniflər">
                                            <i class="bi bi-grid-3x3"></i> @company.ClassCount
                                        </span>
                                        <span class="badge bg-warning text-dark" title="Fənlər">
                                            <i class="bi bi-book"></i> @company.SubjectCount
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    @if (company.IsActive)
                                    {
                                        <span class="badge bg-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@company.Id"
                                           class="btn btn-outline-info" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@company.Id"
                                           class="btn btn-outline-primary" title="Redaktə et">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@company.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning"
                                                    title="@(company.IsActive ? "Deaktiv et" : "Aktiv et")">
                                                <i class="bi bi-@(company.IsActive ? "pause" : "play")-circle"></i>
                                            </button>
                                        </form>

                                        <a asp-action="Delete" asp-route-id="@company.Id"
                                           class="btn btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                    <p class="mt-3">Hələ şirkət qeydiyyatdan keçməyib</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> İlk Şirkəti Yarat
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const filterStatus = document.getElementById('filterStatus');
            const clearFilters = document.getElementById('clearFilters');
            const tableRows = document.querySelectorAll('#companyTable tbody tr');

            function applyFilters() {
                const searchTerm = searchInput.value.toLowerCase();
                const statusValue = filterStatus.value;

                tableRows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    const status = row.dataset.status;

                    let show = true;

                    if (searchTerm && !text.includes(searchTerm)) show = false;
                    if (statusValue && status !== statusValue) show = false;

                    row.style.display = show ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', applyFilters);
            filterStatus.addEventListener('change', applyFilters);

            clearFilters.addEventListener('click', function() {
                searchInput.value = '';
                filterStatus.value = '';
                applyFilters();
            });
        });
    </script>
}