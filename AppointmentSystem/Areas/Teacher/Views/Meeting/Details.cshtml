@model Meeting
@using AppointmentSystem.Models.Enums

@{
    ViewData["Title"] = "Görüş Detalları";
}

<div class="row mb-4">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Təqvim</a></li>
                <li class="breadcrumb-item active">Detal</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <!-- Main Info Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-gradient text-white py-3" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event"></i> Görüş Məlumatları
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Tarix</label>
                        <h6><i class="bi bi-calendar3"></i> @Model.MeetingDate.ToString("dd MMMM yyyy")</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Vaxt</label>
                        <h6>
                            <i class="bi bi-clock"></i>
                            @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
                        </h6>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Şagird</label>
                        <h6><i class="bi bi-person-circle text-primary"></i> @Model.Student.FirstName @Model.Student.LastName</h6>
                        <small class="text-muted">Sinif: @Model.Student.Class?.Name</small>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small mb-1">Valideyn</label>
                        <h6><i class="bi bi-people text-info"></i> @Model.Parent.FirstName @Model.Parent.LastName</h6>
                        @if (!string.IsNullOrEmpty(Model.Parent.PhoneNumber))
                        {
                            <small class="text-muted">
                                <i class="bi bi-telephone"></i> @Model.Parent.PhoneNumber
                            </small>
                        }
                    </div>
                </div>

                <div class="mb-3">
                    <label class="text-muted small mb-1">Status</label>
                    <h5>
                        <span class="badge @GetStatusBadgeClass(Model.Status)">
                            @GetStatusText(Model.Status)
                        </span>
                    </h5>
                </div>

                @if (!string.IsNullOrEmpty(Model.ParentNotes))
                {
                    <div class="alert alert-light border">
                        <label class="text-muted small mb-2">
                            <i class="bi bi-chat-left-text"></i> Valideyn qeydi
                        </label>
                        <p class="mb-0">@Model.ParentNotes</p>
                    </div>
                }
            </div>
        </div>

        <!-- Actions Card -->
        @if (Model.Status == MeetingStatus.Pending)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-check-circle"></i> Təsdiq və ya İmtina</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Approve" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="meetingId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">Qeyd (opsional)</label>
                            <textarea name="teacherNotes" class="form-control" rows="3"
                                  placeholder="Görüşlə bağlı qeydləriniz..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle"></i> Təsdiqlə
                        </button>
                    </form>

                    <hr />

                    <form asp-action="Decline" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="meetingId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label">İmtina səbəbi <span class="text-danger">*</span></label>
                            <textarea name="declineReason" class="form-control" rows="3" required
                                  placeholder="İmtina səbəbini qeyd edin..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Əlavə qeyd (opsional)</label>
                            <textarea name="teacherNotes" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> İmtina et
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Timeline Card -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-clock-history"></i> Tarixçə</h6>
            </div>
            <div class="card-body">
                <ul class="timeline">
                    <li>
                        <strong>Yaradılıb</strong>
                        <br />
                        <small class="text-muted">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</small>
                    </li>
                    @if (Model.ApprovedDate.HasValue)
                    {
                        <li>
                            <strong>Təsdiqlənib</strong>
                            <br />
                            <small class="text-muted">@Model.ApprovedDate.Value.ToString("dd.MM.yyyy HH:mm")</small>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.TeacherNotes))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-journal-text"></i> Mənim Qeydlərim</h6>
                </div>
                <div class="card-body">
                    <p>@Model.TeacherNotes</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.DeclineReason))
        {
            <div class="alert alert-danger">
                <strong><i class="bi bi-exclamation-triangle"></i> İmtina səbəbi:</strong>
                <p class="mb-0 mt-2">@Model.DeclineReason</p>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            list-style: none;
            padding-left: 20px;
            border-left: 2px solid #dee2e6;
        }

            .timeline li {
                position: relative;
                padding-bottom: 20px;
                padding-left: 20px;
            }

                .timeline li:before {
                    content: '';
                    position: absolute;
                    left: -26px;
                    top: 5px;
                    width: 12px;
                    height: 12px;
                    border-radius: 50%;
                    background: #0d6efd;
                    border: 2px solid #fff;
                }
    </style>
}

@functions {
    string GetStatusBadgeClass(MeetingStatus status) => status switch
    {
        MeetingStatus.Pending => "bg-warning",
        MeetingStatus.Approved => "bg-success",
        MeetingStatus.Declined => "bg-danger",
        MeetingStatus.Cancelled => "bg-secondary",
        MeetingStatus.Completed => "bg-info",
        _ => "bg-secondary"
    };

    string GetStatusText(MeetingStatus status) => status switch
    {
        MeetingStatus.Pending => "Gözləyir",
        MeetingStatus.Approved => "Təsdiqlənib",
        MeetingStatus.Declined => "İmtina",
        MeetingStatus.Cancelled => "Ləğv edilib",
        MeetingStatus.Completed => "Tamamlanıb",
        _ => "Bilinmir"
    };
}