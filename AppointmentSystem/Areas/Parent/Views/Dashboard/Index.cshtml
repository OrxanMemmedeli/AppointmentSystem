@using AppointmentSystem.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
    var stats = ViewBag.Stats;
    var upcomingMeetings = ViewBag.UpcomingMeetings as List<AppointmentSystem.Models.Entities.Meeting>;
    var recentActivities = ViewBag.RecentActivities as List<AppointmentSystem.Models.Entities.Meeting>;
}

<div class="row mb-4">
    <div class="col">
        <h2 class="mb-0">Xoş gəlmisiniz! 👋</h2>
        <p class="text-muted">Görüşləriniz və son fəaliyyətlər</p>
    </div>
    <div class="col-auto">
        <a asp-area="Parent" asp-controller="Meeting" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Görüş
        </a>
    </div>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-2">Ümumi Görüşlər</h6>
                        <h2 class="mb-0 text-primary">@stats.TotalMeetings</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded">
                        <i class="bi bi-calendar-event text-primary fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-2">Gələcək</h6>
                        <h2 class="mb-0 text-info">@stats.UpcomingMeetings</h2>
                    </div>
                    <div class="bg-info bg-opacity-10 p-3 rounded">
                        <i class="bi bi-calendar-plus text-info fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-2">Gözləyir</h6>
                        <h2 class="mb-0 text-warning">@stats.PendingApproval</h2>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded">
                        <i class="bi bi-hourglass-split text-warning fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted mb-2">Tamamlanıb</h6>
                        <h2 class="mb-0 text-success">@stats.CompletedMeetings</h2>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded">
                        <i class="bi bi-check-circle text-success fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Meetings & Recent Activities -->
<div class="row g-4">
    <!-- Upcoming Meetings -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-gradient text-white py-3" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h5 class="mb-0"><i class="bi bi-calendar-plus"></i> Yaxın Görüşlər</h5>
            </div>
            <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                @if (upcomingMeetings?.Any() == true)
                {
                    @foreach (var meeting in upcomingMeetings)
                    {
                        <div class="mb-3 p-3 border-start border-4 @(meeting.Status == MeetingStatus.Pending ? "border-warning" : "border-success") bg-light rounded-end">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">
                                        <i class="bi bi-person-badge text-primary"></i> @meeting.Teacher.FirstName @meeting.Teacher.LastName
                                    </h6>
                                    <p class="mb-1 small">
                                        <i class="bi bi-person-circle text-info"></i>
                                        <strong>Şagird:</strong> @meeting.Student.FirstName @meeting.Student.LastName
                                    </p>
                                    <p class="mb-0 text-muted small">
                                        <i class="bi bi-calendar3"></i> @meeting.MeetingDate.ToString("dd MMMM yyyy")
                                        | <i class="bi bi-clock"></i> @meeting.StartTime.ToString(@"hh\:mm") - @meeting.EndTime.ToString(@"hh\:mm")
                                    </p>
                                </div>
                                <div>
                                    <span class="badge bg-@(meeting.Status == MeetingStatus.Pending ? "warning" : "success") mb-2">
                                        @(meeting.Status == MeetingStatus.Pending ? "Gözlənilir" : "Təsdiqlənib")
                                    </span>
                                    <a asp-area="Parent" asp-controller="Meeting" asp-action="Details" asp-route-id="@meeting.Id"
                                       class="btn btn-sm btn-outline-primary d-block">
                                        <i class="bi bi-eye"></i> Bax
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x" style="font-size: 3rem;"></i>
                        <p class="mt-3">Yaxın görüş yoxdur</p>
                        <a asp-area="Parent" asp-controller="Meeting" asp-action="Create" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-circle"></i> İlk Görüşü Yarat
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Activities -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0"><i class="bi bi-activity"></i> Son Fəaliyyətlər</h5>
            </div>
            <div class="card-body" style="max-height: 500px; overflow-y: auto;">
                @if (recentActivities?.Any() == true)
                {
                    <div class="timeline">
                        @foreach (var activity in recentActivities.Take(10))
                        {
                            <div class="timeline-item mb-3">
                                <div class="timeline-marker bg-@GetStatusColor(activity.Status)"></div>
                                <div class="timeline-content">
                                    <small class="text-muted">@((activity.ModifiedDate ?? activity.CreatedDate).ToString("dd.MM.yyyy HH:mm"))</small>
                                    <p class="mb-1 fw-semibold">@activity.Teacher.FirstName @activity.Teacher.LastName</p>
                                    <small class="text-muted">
                                        @GetActivityText(activity.Status)
                                    </small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">Fəaliyyət yoxdur</p>
                }
            </div>
        </div>

        <!-- Children Card -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body text-center">
                <i class="bi bi-person-hearts text-primary" style="font-size: 2.5rem;"></i>
                <h3 class="mt-2 mb-0">@stats.MyChildren</h3>
                <p class="text-muted mb-0">Övladlarım</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

            .timeline:before {
                content: '';
                position: absolute;
                left: 8px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #dee2e6;
            }

        .timeline-item {
            position: relative;
        }

        .timeline-marker {
            position: absolute;
            left: -26px;
            top: 5px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid white;
            box-shadow: 0 0 0 2px #dee2e6;
        }
    </style>
}

@functions {
    string GetStatusColor(MeetingStatus status) => status switch
    {
        MeetingStatus.Pending => "warning",
        MeetingStatus.Approved => "success",
        MeetingStatus.Declined => "danger",
        MeetingStatus.Cancelled => "secondary",
        MeetingStatus.Completed => "info",
        _ => "secondary"
    };

    string GetActivityText(MeetingStatus status) => status switch
    {
        MeetingStatus.Pending => "Görüş yaradıldı, təsdiq gözlənilir",
        MeetingStatus.Approved => "Görüş təsdiqləndi",
        MeetingStatus.Declined => "Görüş rədd edildi",
        MeetingStatus.Cancelled => "Görüş ləğv edildi",
        MeetingStatus.Completed => "Görüş tamamlandı",
        _ => "Status yeniləndi"
    };
}